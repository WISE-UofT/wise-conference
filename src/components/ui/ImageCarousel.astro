---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: ImageMetadata[];
  labelPrefix?: string;
  class?: string;
}

const {
  images,
  labelPrefix = "WISE Conference image",
  class: className = "",
} = Astro.props;
---

<div
  class={`mx-auto grid w-full max-w-4xl gap-3 ${className}`.trim()}
  data-carousel
>
  <div
    class="overflow-hidden rounded-2xl border border-blue-navy/12 shadow-[0_10px_25px_rgb(16_31_70/0.08)]"
  >
    <div
      class="flex transition-transform duration-420 ease-out will-change-transform"
      data-carousel-track
    >
      {
        images.map((image, index) => (
          <div class="h-[clamp(220px,48vw,420px)] w-full min-w-full">
            <Image
              src={image}
              alt={`${labelPrefix} ${index + 1}`}
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </div>
        ))
      }
    </div>
  </div>

  <div class="flex items-center justify-between gap-3 max-sm:justify-center">
    <button
      type="button"
      class="rounded-full border border-blue-navy/25 bg-white px-3.5 py-1.5 text-[0.8rem] font-bold tracking-[0.02em] text-blue-navy transition hover:border-blue-navy/45 hover:bg-blue-navy/6 max-sm:hidden"
      data-carousel-prev
      aria-label="Previous recap image"
    >
      Prev
    </button>

    <div class="flex flex-wrap justify-center gap-2" data-carousel-dots>
      {
        images.map((_, index) => (
          <button
            type="button"
            class="h-2.5 w-2.5 rounded-full bg-blue-navy/20 p-0"
            data-carousel-dot
            data-index={index}
            aria-label={`Go to recap image ${index + 1}`}
          />
        ))
      }
    </div>

    <button
      type="button"
      class="rounded-full border border-blue-navy/25 bg-white px-3.5 py-1.5 text-[0.8rem] font-bold tracking-[0.02em] text-blue-navy transition hover:border-blue-navy/45 hover:bg-blue-navy/6 max-sm:hidden"
      data-carousel-next
      aria-label="Next recap image"
    >
      Next
    </button>
  </div>
</div>

<script>
  const carousels = document.querySelectorAll<HTMLElement>("[data-carousel]");

  carousels.forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-carousel-track]");
    const prevButton = carousel.querySelector<HTMLButtonElement>(
      "[data-carousel-prev]",
    );
    const nextButton = carousel.querySelector<HTMLButtonElement>(
      "[data-carousel-next]",
    );
    const dots = Array.from(
      carousel.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]"),
    );

    if (!track || !prevButton || !nextButton || dots.length === 0) {
      return;
    }

    const slideCount = dots.length;
    let currentIndex = 0;
    let autoplayId: number | undefined;

    const updateCarousel = () => {
      track.style.transform = `translateX(-${currentIndex * 100}%)`;
      dots.forEach((dot, index) => {
        dot.setAttribute(
          "aria-current",
          index === currentIndex ? "true" : "false",
        );
        dot.classList.toggle("bg-purple-primary", index === currentIndex);
        dot.classList.toggle("bg-blue-navy/20", index !== currentIndex);
      });
    };

    const goTo = (nextIndex: number) => {
      currentIndex = (nextIndex + slideCount) % slideCount;
      updateCarousel();
    };

    const startAutoplay = () => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        return;
      }
      autoplayId = window.setInterval(() => goTo(currentIndex + 1), 5000);
    };

    const stopAutoplay = () => {
      if (autoplayId) {
        window.clearInterval(autoplayId);
        autoplayId = undefined;
      }
    };

    prevButton.addEventListener("click", () => {
      stopAutoplay();
      goTo(currentIndex - 1);
      startAutoplay();
    });

    nextButton.addEventListener("click", () => {
      stopAutoplay();
      goTo(currentIndex + 1);
      startAutoplay();
    });

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const index = Number(dot.dataset.index ?? "0");
        stopAutoplay();
        goTo(index);
        startAutoplay();
      });
    });

    updateCarousel();
    startAutoplay();
  });
</script>
