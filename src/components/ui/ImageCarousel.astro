---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: ImageMetadata[];
  labelPrefix?: string;
  class?: string;
  slideClass?: string;
}

const {
  images,
  labelPrefix = "WISE Conference image",
  class: className = "",
  slideClass = "",
} = Astro.props;
---

<div
  class={`mx-auto grid w-full max-w-4xl gap-3 ${className}`.trim()}
  data-carousel
>
  <div
    class="relative overflow-hidden rounded-2xl border border-blue-navy/12 shadow-[0_10px_25px_rgb(16_31_70/0.08)]"
  >
    <div
      class="flex transition-transform duration-420 ease-out will-change-transform"
      data-carousel-track
    >
      {
        images.map((image, index) => (
          <div
            class={`h-[clamp(220px,48vw,420px)] w-full min-w-full ${slideClass}`.trim()}
          >
            <Image
              src={image}
              alt={`${labelPrefix} ${index + 1}`}
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </div>
        ))
      }
    </div>

    {
      images.length > 1 && (
        <>
          <button
            type="button"
            class="absolute top-1/2 left-3 z-10 flex size-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-white/50 bg-blue-navy/55 text-white shadow-lg backdrop-blur-sm transition hover:scale-105 hover:bg-blue-navy/75 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:left-5 sm:size-12"
            data-carousel-prev
            aria-label="Previous image"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              class="size-5 sm:size-6"
            >
              <path
                d="m15 18-6-6 6-6"
                stroke="currentColor"
                stroke-width="2.25"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>

          <button
            type="button"
            class="absolute top-1/2 right-3 z-10 flex size-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full border border-white/50 bg-blue-navy/55 text-white shadow-lg backdrop-blur-sm transition hover:scale-105 hover:bg-blue-navy/75 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:right-5 sm:size-12"
            data-carousel-next
            aria-label="Next image"
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              class="size-5 sm:size-6"
            >
              <path
                d="m9 18 6-6-6-6"
                stroke="currentColor"
                stroke-width="2.25"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        </>
      )
    }
  </div>

  {
    images.length > 1 && (
    <div class="flex flex-wrap justify-center gap-2" data-carousel-dots>
      {
        images.map((_, index) => (
          <button
            type="button"
            class="h-2.5 w-2.5 rounded-full bg-blue-navy/20 p-0"
            data-carousel-dot
            data-index={index}
            aria-label={`Go to recap image ${index + 1}`}
          />
        ))
      }
    </div>
    )
  }
</div>

<script>
  const carousels = document.querySelectorAll<HTMLElement>("[data-carousel]");

  carousels.forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-carousel-track]");
    const prevButton = carousel.querySelector<HTMLButtonElement>(
      "[data-carousel-prev]",
    );
    const nextButton = carousel.querySelector<HTMLButtonElement>(
      "[data-carousel-next]",
    );
    const dots = Array.from(
      carousel.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]"),
    );

    if (!track || !prevButton || !nextButton || dots.length === 0) {
      return;
    }

    const slideCount = dots.length;
    let currentIndex = 0;
    let autoplayId: number | undefined;

    const updateCarousel = () => {
      track.style.transform = `translateX(-${currentIndex * 100}%)`;
      dots.forEach((dot, index) => {
        dot.setAttribute(
          "aria-current",
          index === currentIndex ? "true" : "false",
        );
        dot.classList.toggle("bg-purple-primary", index === currentIndex);
        dot.classList.toggle("bg-blue-navy/20", index !== currentIndex);
      });
    };

    const goTo = (nextIndex: number) => {
      currentIndex = (nextIndex + slideCount) % slideCount;
      updateCarousel();
    };

    const startAutoplay = () => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        return;
      }
      autoplayId = window.setInterval(() => goTo(currentIndex + 1), 5000);
    };

    const stopAutoplay = () => {
      if (autoplayId) {
        window.clearInterval(autoplayId);
        autoplayId = undefined;
      }
    };

    prevButton.addEventListener("click", () => {
      stopAutoplay();
      goTo(currentIndex - 1);
      startAutoplay();
    });

    nextButton.addEventListener("click", () => {
      stopAutoplay();
      goTo(currentIndex + 1);
      startAutoplay();
    });

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const index = Number(dot.dataset.index ?? "0");
        stopAutoplay();
        goTo(index);
        startAutoplay();
      });
    });

    updateCarousel();
    startAutoplay();
  });
</script>
