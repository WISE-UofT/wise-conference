---
interface Props {
  title: string;
  content?: string;
  open?: boolean;
  class?: string;
  titleClass?: string;
  contentClass?: string;
}

const {
  title,
  content,
  open = false,
  class: className = "",
  titleClass = "",
  contentClass = "",
} = Astro.props;
---

<details
  open={open}
  class={`group rounded-2xl border border-blue-navy/10 bg-white p-5 shadow-sm ${className}`.trim()}
>
  <summary
    class={`flex cursor-pointer list-none items-center justify-between text-base font-semibold text-blue-navy ${titleClass}`.trim()}
  >
    {title}
    <span
      class="ml-4 shrink-0 transition-transform duration-200 group-open:rotate-180"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-5 w-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"
        ></path>
      </svg>
    </span>
  </summary>
  <div
    class={`pt-3 text-base leading-7 text-blue-navy/80 ${contentClass}`.trim()}
  >
    <slot>{content}</slot>
  </div>
</details>
