---
interface Props {
  title: string;
  content?: string;
  open?: boolean;
  class?: string;
  titleClass?: string;
  contentClass?: string;
  variant?: "card" | "plain";
}

const {
  title,
  content,
  open = false,
  class: className = "",
  titleClass = "",
  contentClass = "",
  variant = "card",
} = Astro.props;

const isPlain = variant === "plain";
---

<details
  open={open}
  class:list={[
    "group",
    isPlain
      ? "border-b border-ink/10 py-3.5"
      : "rounded-2xl border border-ink/10 bg-white p-5 shadow-sm",
    className,
  ]}
>
  <summary
    class:list={[
      "flex cursor-pointer list-none items-center justify-between gap-4 font-sans text-ink",
      isPlain ? "text-base font-medium" : "text-base font-semibold",
      titleClass,
    ]}
  >
    <span>{title}</span>
    {
      isPlain ? (
        <span
          class="shrink-0 text-xl leading-none font-light text-ink/40"
          aria-hidden="true"
        >
          <span class="group-open:hidden">+</span>
          <span class="hidden group-open:inline">−</span>
        </span>
      ) : (
        <span class="ml-4 shrink-0 transition-transform duration-200 group-open:rotate-180">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19 9l-7 7-7-7"
            />
          </svg>
        </span>
      )
    }
  </summary>
  <div
    class:list={[
      "font-sans text-base leading-7 text-ink/85",
      isPlain ? "pt-3" : "pt-3",
      contentClass,
    ]}
  >
    <slot>{content}</slot>
  </div>
</details>
