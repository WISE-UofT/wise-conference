---
interface Props {
  title: string;
  link: string;
  filled?: boolean;
}

const { title, link, filled = false } = Astro.props;
---

<li>
  <a
    href={link}
    class:list={[
      "inline-flex items-center justify-center whitespace-nowrap rounded-full font-semibold tracking-tight text-ink transition",
      filled
        ? "bg-[#fec9f5] px-5 py-2 text-sm hover:bg-[#f7bddf]"
        : "px-2.5 py-1.5 text-[13px] hover:bg-white/55",
    ]}
  >
    {title}
  </a>
</li>
