---
import SpeakerRow from "../speakers/SpeakerRow.astro";

interface CompetitionData {
  fileName: string;
  name: string;
  datetime: string;
  location: string;
  deadline: string;
  signup: string;
  sponsorLogo: string;
  prize: string;
  description: string;
  descriptionBullets: string[];
}

interface Props {
  competition: CompetitionData;
}

const { competition } = Astro.props as Props;

const descriptionParagraphs = competition.description
  .split("\n\n")
  .map((part) => part.trim())
  .filter(Boolean);

const descriptionBullets = competition.descriptionBullets
  .map((line) => line.trim())
  .filter(Boolean);

const hasPrize = competition.prize.trim().length > 0;
---

<article class="rounded-2xl border border-blue-navy/10 bg-white p-6 shadow-sm">
  <div class="mb-4 flex items-center gap-4">
    {
      competition.sponsorLogo && (
        <img
          src={competition.sponsorLogo}
          alt={competition.name}
          class="max-h-16 w-auto max-w-36 rounded-md object-contain"
        />
      )
    }
    <h3 class="text-2xl font-semibold text-blue-navy">{competition.name}</h3>
  </div>
  {
    descriptionParagraphs.map((paragraph, index) => (
      <p
        class:list={[
          "text-base leading-6 text-blue-navy/80",
          index > 0 && "mt-3",
        ]}
      >
        {paragraph}
      </p>
    ))
  }
  {
    descriptionBullets.length > 0 && (
      <ul class="mt-3 list-disc space-y-1 pl-5 text-base leading-6 text-blue-navy/80">
        {descriptionBullets.map((bullet) => (
          <li>{bullet}</li>
        ))}
      </ul>
    )
  }
  <dl class="mt-4 space-y-2 text-base text-blue-navy/85">
    <div>
      <dt class="font-semibold text-purple-primary">When</dt>
      <dd>{competition.datetime}</dd>
    </div>
    <div>
      <dt class="font-semibold text-purple-primary">Where</dt>
      <dd>{competition.location}</dd>
    </div>
    <div>
      <dt class="font-semibold text-purple-primary">Deadline</dt>
      <dd>{competition.deadline}</dd>
    </div>
    {
      hasPrize && (
        <div>
          <dt class="font-semibold text-purple-primary">Prize</dt>
          <dd>{competition.prize}</dd>
        </div>
      )
    }
  </dl>
  <a
    href={competition.signup}
    target="_blank"
    rel="noreferrer"
    class="mt-5 inline-block rounded-full bg-purple-primary px-5 py-2 text-sm font-semibold text-white transition hover:bg-blue-navy"
  >
    Sign Up
  </a>

  <div class="mt-8 border-t border-blue-navy/10 pt-6">
    <h4 class="mb-4 text-xl font-semibold text-blue-navy">Judges</h4>
    <SpeakerRow
      title="Judges"
      subtitle=""
      description=""
      dataSource={competition.fileName}
      dataFolder="competitions"
      align="left"
      showHeader={false}
      class="mb-0"
    />
  </div>
</article>
