---
import discountsContent from "../../content/discounts/discounts-content.json";
import discountsData from "../../content/discounts/discounts-data.json";
import SectionLayout from "../../layouts/SectionLayout.astro";
import Collapsible from "../ui/Collapsible.astro";
import Discount from "../discounts/Discount.astro";

const data = discountsData as Record<
  string,
  { used: number; limit: number; available: number }
>;

const schools = Object.entries(discountsContent).sort(([a], [b]) =>
  a.localeCompare(b),
);
---

<SectionLayout title="Discounts">
  <p
    class="mb-6 max-w-4xl text-base text-center font-medium mx-auto md:leading-7 text-blue-navy"
  >
    Thank you to the following schools for supporting the WISE National
    Conference 2026! For questions about discounts, please contact <a
      href="mailto:conference.academics@wise.skule.ca"
      >conference.academics@wise.skule.ca</a
    >.
  </p>
  <p
    class="mb-6 max-w-4xl text-sm italic text-center mx-auto md:leading-7 text-blue-navy/80"
  >
    All emails and student numbers associated with any discounted purchase will
    be sent to the respective school and faculty to confirm enrollment. Thus,
    for any discounted tickets, please ensure your affiliated school email is
    being used for the purchase.
  </p>
  <div class="grid gap-5">
    {
      schools.map(([school, departments]) => (
        <Collapsible
          title={school}
          class="p-0"
          titleClass="gap-4 p-0 md:px-4 md:py-2 md:text-xl font-semibold text-purple-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-primary/50"
          contentClass="p-0 md:px-4 pt-0 space-y-3 text-sm md:text-base md:leading-7 text-blue-navy/85 [&_h1]:mt-4 md:[&_h1]:text-lg [&_h1]:font-semibold [&_h1]:text-blue-navy [&_p]:m-0 [&_strong]:text-purple-primary"
        >
          {Object.entries(departments).map(
            ([dept, { content, code, displayCode }]) => {
              const { available, limit } = data[code ?? ""] ?? {
                available: 0,
                limit: 0,
              };
              return (
                <Discount
                  department={dept !== "General" ? dept : undefined}
                  content={content}
                  code={code}
                  displayCode={displayCode}
                  available={available}
                  limit={limit}
                />
              );
            },
          )}
        </Collapsible>
      ))
    }
  </div>
</SectionLayout>
