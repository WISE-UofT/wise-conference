---
import SectionLayout from "../../layouts/SectionLayout.astro";
import Competition from "../competitions/Competition.astro";
import cubeLogo from "../../assets/sponsors/corporate/cube.webp";
import cohereLogo from "../../assets/sponsors/corporate/cohere.webp";

interface CompetitionCardData {
  fileName: string;
  name: string;
  datetime: string;
  location: string;
  deadline: string;
  signup: string;
  sponsorLogo: string;
  prize: string;
  description: string;
  descriptionBullets: string[];
}

const competitionOrder = [
  "cube-competition.json",
  "5mt-competition.json",
  "cohere-competition.json",
  "poster-fair-competition.json",
];

const competitionData: CompetitionCardData[] = [
  {
    fileName: "cube-competition.json",
    name: "CUBE Case Competition",
    datetime: "Saturday, January 17, 2026 · 10:30 AM - 12:00 PM",
    location: "Pier 9",
    deadline: "January 13, 2026 · 11:59 PM",
    signup:
      "https://docs.google.com/forms/d/e/1FAIpQLSfBemdrhmk_RE9Dj-y6J0zwt3R4i2LEdHvjA1lJ9Ba2F2l3rA/viewform?usp=dialog",
    sponsorLogo: cubeLogo.src,
    prize: "First place team: $300",
    description:
      "Participants will work in teams to tackle a real-world global health challenge focused on neglected tropical diseases. Contestants will leverage computational modeling and bioinformatic techniques to develop an innovative solution, which they will present to a judging panel. A detailed case brief outlining the problem and expectations will be released closer to the competition date. Students may register as a team or request to be placed into one.",
    descriptionBullets: [
      "Teams must be of 3-4 and will give a 7 minute presentation to a panel of judges followed by a 3 minute Q&A.",
      "The presentation will be accompanied by a technical demonstration or concept prototype.",
      "Students from any department, faculty, or institution are welcome to participate together.",
      "Teams will be judged on innovation, feasibility, public health impact and overall clarity of communication.",
    ],
  },
  {
    fileName: "5mt-competition.json",
    name: "5 Minute Thesis (5MT)",
    datetime: "Saturday, January 17, 2026 · 1:00 PM to 3:00 PM",
    location: "Pier 9",
    deadline: "January 13, 2026 · 11:59 PM",
    signup:
      "https://docs.google.com/forms/d/e/1FAIpQLSf4wZJN59OdZvvQBUck4Vkv2c2jR_YgLyuB8lr1LzQMhRybjw/viewform?usp=sharing&ouid=113257861058742861745",
    sponsorLogo: "",
    prize: "$300 (1st), $200 (2nd), $100 (3rd)",
    description:
      "We invite students from any STEM background to present their research to a panel of judges and have the opportunity to showcase their findings to a wider audience. Participants will be given five minutes to present their thesis research in an engaging manner using only one static slide. In partnership with URNCST, all abstracts will get published in our WISE journal book (as long as they follow our guidelines).",
    descriptionBullets: [
      "Only one static slide is permitted.",
      "No additional electronic media or props are allowed.",
      "Presentations are limited to 5 minutes maximum and competitors exceeding 5 minutes will face a penalty.",
      "Presentations will be assessed on communication, comprehension, engagement and quality of work.",
    ],
  },
  {
    fileName: "cohere-competition.json",
    name: "Cohere Hackathon",
    datetime: "Sunday, January 18, 2026 · 10:00 AM to 12:00 PM",
    location: "Pier 9",
    deadline: "January 13, 2026 · 11:59 PM",
    signup: "https://forms.gle/6FdShSqhSqMyBwBC6",
    sponsorLogo: cohereLogo.src,
    prize:
      "$500 (1st), $250 (2nd), $1000 in Cohere credits (3rd). Additionally, individuals from the top three teams may be considered for internship interviews with Cohere.",
    description:
      "We invite students to come work in teams to design and build MCP (Model Context Protocol) tools to power creative AI use cases! Building on the Cohere workshop on 17 Jan, this hackathon will challenge participants to go beyond standard generative AI and develop tools that can meaningfully augment everyday life, from intelligent schedulers to personalized assistants. Starter code and resources will be provided to all participants.",
    descriptionBullets: [
      "Participants are strongly encouraged to attend the Cohere workshop on 17 January, Saturday from 1PM - 2:30PM EST.",
      "The hacking period will take place from Saturday afternoon to Sunday morning.",
      "Teams of 3-4 will present their final projects to a panel of Cohere judges in a live pitch format on 18 January, Sunday from 10AM - 12PM EST.",
      "The winning designs will be evaluated on creativity, functionality, and innovation.",
    ],
  },
  {
    fileName: "poster-fair-competition.json",
    name: "Poster Fair",
    datetime: "Sunday, January 18, 2026 · 3:00 PM to 4:00 PM",
    location: "Harbour Foyer",
    deadline: "December 19, 2025 · 11:59 PM",
    signup:
      "https://docs.google.com/forms/d/e/1FAIpQLSd43EVFPskc3-PEl2N4Boy8IpCIsg_iOPtsvtdesAe8maKs1w/viewform?usp=header",
    sponsorLogo: "",
    prize: "",
    description:
      "WISE is thrilled to invite students of all STEM backgrounds and years of study to share your research with the WISE community and practice your scientific communication.\n\nWe invite submissions describing new research and innovations across STEM fields. These could include original research projects, literature reviews, case studies, program evaluations, or other initiatives showcasing advancements in science, technology, engineering, and mathematics. We are also partnering with URNCST to publish a WISENC 2026 Abstract Book, where you will have the opportunity to have your abstract published.\n\nThe event's structure will allow participants to walk freely around the room and present their poster to a judge.",
    descriptionBullets: [
      "Participants will be assigned a 3 minute judging slot during which they must be present at their posters.",
      "Those who wish to present work done alongside a PI or in any lab must get permission from their supervisors to present their research.",
      "Posters will be judged based on presentation skills, poster visuals, and research competence.",
    ],
  },
];

const competitions = competitionOrder
  .map((fileName) => {
    const baseCompetition = competitionData.find(
      (competition) => competition.fileName === fileName,
    );

    return baseCompetition ?? null;
  })
  .filter(
    (competition): competition is CompetitionCardData => competition !== null,
  );
---

<SectionLayout title="Competitions">
  <p
    class="mb-8 max-w-4xl mx-auto text-base text-center leading-7 text-blue-navy/85"
  >
    The WISE National Conference competitions provide an opportunity for
    participants from various fields to apply knowledge learned in class and
    solve real-world problems. All conference attendees are eligible to
    participate! You must purchase a ticket for WISE NC 2026 before registering
    for our competitions. Please be advised that competitions registrations are
    accepted on a rolling, first-come-first-served basis for limited spaces.
  </p>

  <div class="space-y-10">
    {
      competitions.map((competition) => (
        <Competition competition={competition} />
      ))
    }
  </div>
</SectionLayout>
