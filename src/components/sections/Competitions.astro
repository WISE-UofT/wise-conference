---
import SectionLayout from "../../layouts/SectionLayout.astro";
import PersonCard from "../speakers/PersonCard.astro";
import PersonGrid from "../speakers/PersonGrid.astro";
import erin from "../../assets/competitions/Erin Ricaloglu.jpg";
import dream from "../../assets/competitions/Dream Tuitt-Barnes.jpg";

const blurb =
  "Explore the rapidly evolving world of neurotechnology and brain-computer interfaces with experts working across research, healthcare, and industry. Hear how they're turning brain signals into real-world applications, the paths that brought them into the field, and what breakthroughs could shape the future of how humans interact with technology.";
---

<SectionLayout title="Competitions" id="competitions">
  <div class="max-w-3xl space-y-4 text-[0.98rem] leading-7 text-ink/90">
    <p>
      The WISE National Conference (WISE NC) competitions provide an opportunity
      for participants from various fields to apply knowledge learned in class
      and solve real-world problems.
    </p>
    <p>
      All conference attendees are eligible to participate! You must purchase a
      ticket for WISE NC 2027 before registering for our competitions. Please
      be advised that competitions registrations are accepted on a rolling,
      first-come-first-served basis for limited spaces.
    </p>
  </div>

  <p class="mt-6 text-center text-[0.98rem] leading-7 text-ink/90">
    Stay tuned for more details!
  </p>

  <h3 class="mt-12 text-center font-serif text-2xl font-medium text-ink">
    Competition Judges
  </h3>
  <PersonGrid count={3} maxColumns={3} class="mt-8">
    <PersonCard
      name="Erin Ricaloglu"
      title="PhD Student, Behavioural Neuroscience @ University of Toronto"
      image={erin}
      objectPosition="center 46%"
      bio="Erin Ricaloglu is a PhD student in Behavioural Neuroscience at the University of Toronto, where she studies the role of epigenetics in memory and Alzheimer’s disease. Her research explores how changes in gene regulation contribute to brain function and neurodegeneration. Outside of the lab, she is passionate about making science more accessible and supporting young women pursuing careers in STEM. Erin looks forward to connecting with students and hearing about their research and ideas at WISENC 2027."
    />
    <PersonCard
      name="Dream Tuitt-Barnes"
      title="Medical Student @ Queen's University"
      image={dream}
      objectPosition="center 28%"
      bio="Dream Tuitt-Barnes is a third-year medical student at Queen’s University, where she entered medicine through the Queen’s Accelerated Route to Medical School (QuARMS). An aspiring plastic and reconstructive surgeon, her research interests span surgical outcomes, health equity, medical education, and artificial intelligence in healthcare. She is passionate about advancing representation in medicine, promoting equitable access to healthcare, and empowering underrepresented youth through mentorship and advocacy. Recognized as one of Canada’s Top 100 Black Women to Watch in 2026, Dream is committed to leveraging research, leadership, and community engagement to drive meaningful change and inspire the next generation of women in STEM."
    />
    <PersonCard
      name="Clara Phillips"
      title="Postdoctoral Fellow @ University of Toronto"
      bio="Clara Phillips is a Postdoctoral Fellow at the University of Toronto, supported by NSERC and the UHN Canada Leads program. She completed her PhD in Mechanical and Industrial Engineering at the University of Toronto in 2026. Her research combines structural testing and design of lower-limb prosthetic sockets to (1) increase the successful uptake of 3D printing in clinical workflows, and (2) design more comfortable, better-fitting devices for people with limb loss. She works closely with clinicians and industry partners to move these advances from the lab into practice."
    />
  </PersonGrid>

  <!--
    Competition postcards are commented out until that content is ready.
    {
      [0, 1].map(() => (
        <article class="rounded-2xl border-2 border-[#f3c6d8] bg-white/80 p-6 md:p-8">
          <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_1px_minmax(0,1fr)]">
            <div>
              <h3 class="font-serif text-2xl font-medium text-ink">
                Competition Name
              </h3>
              <p class="mt-2 text-sm text-ink/80">Host Names</p>
              <p class="text-sm text-ink/70">
                Saturday, 10:30AM - 12:00PM | Pier 4
              </p>
              <p class="mt-4 text-[0.95rem] leading-7 text-ink/90">{blurb}</p>
              <a
                href="#"
                class="mt-6 inline-flex rounded-md bg-[#ddd0f8] px-4 py-2 text-sm font-semibold text-ink transition hover:bg-lilac"
              >
                Sign up here!
              </a>
            </div>
            <div class="hidden bg-ink/10 lg:block" aria-hidden="true" />
            <div class="relative">
              <div
                class="absolute top-0 right-0 h-12 w-14 bg-lilac"
                role="img"
                aria-label="Competition image coming soon"
              />
              <div class="flex flex-wrap justify-center gap-4 pt-16">
                {Array.from({ length: 3 }).map(() => (
                  <div
                    class="aspect-square w-28 bg-lilac sm:w-32"
                    role="img"
                    aria-label="Competition host photo coming soon"
                  />
                ))}
              </div>
            </div>
          </div>
        </article>
      ))
    }
  -->
</SectionLayout>
