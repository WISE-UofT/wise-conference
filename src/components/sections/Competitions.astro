---
import SectionLayout from "../../layouts/SectionLayout.astro";

const competitions = [
	{
		name: "CUBE Case Competition",
		datetime: "Saturday, January 17, 2026 · 10:30 AM to 12:00 PM EST",
		location: "Pier 9",
		deadline: "January 13, 2026 · 11:59 PM",
		signup:
			"https://docs.google.com/forms/d/e/1FAIpQLSfBemdrhmk_RE9Dj-y6J0zwt3R4i2LEdHvjA1lJ9Ba2F2l3rA/viewform?usp=dialog",
		sponsorLogo: "/img/sponsors/corporate/cube.webp",
		prize: "First place team: $300",
		description:
			"Participants tackle a global health challenge focused on neglected tropical diseases and present an innovation-focused solution.",
	},
	{
		name: "5 Minute Thesis (5MT)",
		datetime: "Saturday, January 17, 2026 · 1:00 PM to 3:00 PM EST",
		location: "Pier 9",
		deadline: "January 13, 2026 · 11:59 PM",
		signup:
			"https://docs.google.com/forms/d/e/1FAIpQLSf4wZJN59OdZvvQBUck4Vkv2c2jR_YgLyuB8lr1LzQMhRybjw/viewform?usp=sharing&ouid=113257861058742861745",
		sponsorLogo: "/img/competitions/melanie-courtot.webp",
		prize: "$300 (1st), $200 (2nd), $100 (3rd)",
		description:
			"Present your research in five minutes with one static slide. Abstracts are eligible for publication in the WISE journal book.",
	},
	{
		name: "Cohere Hackathon",
		datetime: "Sunday, January 18, 2026 · 10:00 AM to 12:00 PM EST",
		location: "Pier 9",
		deadline: "January 13, 2026 · 11:59 PM",
		signup: "https://forms.gle/6FdShSqhSqMyBwBC6",
		sponsorLogo: "/img/sponsors/corporate/cohere.webp",
		prize: "$500 (1st), $250 (2nd), $1000 in Cohere credits (3rd)",
		description:
			"Build MCP-powered AI tools in teams and present live to Cohere judges. Top teams may be considered for internship interviews.",
	},
];

const judges = [
	{ name: "Lindsey Fiddes", image: "/img/competitions/lindsey-fiddes.webp" },
	{ name: "Lucy Ma", image: "/img/competitions/lucy-ma.webp" },
	{ name: "Emily Somerset", image: "/img/competitions/emily-somerset.webp" },
	{ name: "Ana-Maria Oproescu", image: "/img/competitions/ana-maria-oproescu.webp" },
	{ name: "Mélanie Courtot", image: "/img/competitions/melanie-courtot.webp" },
	{ name: "Ania Harlick", image: "/img/competitions/ania-harlick.webp" },
	{ name: "Ivan Zhang", image: "/img/competitions/ivan-zhang.webp" },
	{ name: "Eugene Cho", image: "/img/competitions/eugene-cho.webp" },
];
---

<SectionLayout title="Competitions">
	<p class="mb-8 max-w-4xl text-base leading-7 text-blue-navy/85">
		WISE competitions are open to all conference attendees and run on a first-come, first-served basis.
		Register early to secure a spot and prepare with your team before conference weekend.
	</p>

	<div class="grid gap-6 xl:grid-cols-3">
		{competitions.map((competition) => (
			<article class="rounded-2xl border border-blue-navy/10 bg-white p-6 shadow-sm">
				<div class="mb-4 flex items-center gap-3">
					<img src={competition.sponsorLogo} alt={competition.name} class="h-12 w-12 rounded-md object-cover" />
					<h3 class="text-xl font-semibold text-blue-navy">{competition.name}</h3>
				</div>
				<p class="text-sm leading-6 text-blue-navy/80">{competition.description}</p>
				<dl class="mt-4 space-y-2 text-sm text-blue-navy/85">
					<div>
						<dt class="font-semibold text-purple-primary">When</dt>
						<dd>{competition.datetime}</dd>
					</div>
					<div>
						<dt class="font-semibold text-purple-primary">Where</dt>
						<dd>{competition.location}</dd>
					</div>
					<div>
						<dt class="font-semibold text-purple-primary">Deadline</dt>
						<dd>{competition.deadline}</dd>
					</div>
					<div>
						<dt class="font-semibold text-purple-primary">Prize</dt>
						<dd>{competition.prize}</dd>
					</div>
				</dl>
				<a
					href={competition.signup}
					target="_blank"
					rel="noreferrer"
					class="mt-5 inline-block rounded-full bg-purple-primary px-5 py-2 text-sm font-semibold text-white transition hover:bg-blue-navy"
				>
					Sign Up
				</a>
			</article>
		))}
	</div>

	<div class="mt-10">
		<h3 class="mb-4 text-2xl font-semibold text-blue-navy">Featured Judges</h3>
		<div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
			{judges.map((judge) => (
				<article class="overflow-hidden rounded-xl border border-blue-navy/10 bg-white shadow-sm">
					<img src={judge.image} alt={judge.name} loading="lazy" class="h-44 w-full object-cover" />
					<p class="p-3 text-sm font-semibold text-blue-navy">{judge.name}</p>
				</article>
			))}
		</div>
	</div>
</SectionLayout>