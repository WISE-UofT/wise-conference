---
import SectionLayout from "../../layouts/SectionLayout.astro";
import Competition from "../competitions/Competition.astro";
import cubeLogo from "../../assets/sponsors/corporate/cube.webp";
import cohereLogo from "../../assets/sponsors/corporate/cohere.webp";
import competitionData from "../../content/competitions/competitions-content.json";

const logoMap: Record<string, string> = {
  cube: cubeLogo.src,
  cohere: cohereLogo.src,
};

const competitions = competitionData.map((c) => ({
  ...c,
  sponsorLogo: logoMap[c.sponsorLogo] ?? "",
}));
---

<SectionLayout title="Competitions">
  <p
    class="mb-8 max-w-4xl mx-auto text-base text-center leading-7 text-blue-navy/85"
  >
    The WISE National Conference competitions provide an opportunity for
    participants from various fields to apply knowledge learned in class and
    solve real-world problems. All conference attendees are eligible to
    participate! You must purchase a ticket for WISE NC 2026 before registering
    for our competitions. Please be advised that competitions registrations are
    accepted on a rolling, first-come-first-served basis for limited spaces.
  </p>

  <div class="space-y-10">
    {
      competitions.map((competition) => (
        <Competition competition={competition} />
      ))
    }
  </div>
</SectionLayout>
