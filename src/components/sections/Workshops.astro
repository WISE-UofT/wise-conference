---
import SectionLayout from "../../layouts/SectionLayout.astro";
import PersonCard from "../speakers/PersonCard.astro";
import { workshopGroups } from "../../content/workshops/hosts";
import type { ImageMetadata } from "astro";
import rukevwe from "../../assets/workshops/IMG_6065 - Rukkie Inikori.jpeg";
import puneet from "../../assets/workshops/Puneet Sidhu_Headshot - Puneet Sidhu.png";
import amel from "../../assets/workshops/Amel Sassi_Headshot pic - Amel Sassi.png";
import sampada from "../../assets/workshops/Sampada Bodkhe - Sampada Bodkhe.jpg";
import anjali from "../../assets/workshops/Pinpoint_AKR7578 - CLEAN CREATE.jpg";
import shrivani from "../../assets/workshops/Shrivani Pandiya - SHRIVANI PANDIYA.JPG";
import roberta from "../../assets/workshops/woods - Artsci Salon.JPG";
import nema from "../../assets/workshops/Headshot - Nema McGlynn.jpg";

const images: Record<string, ImageMetadata> = {
  "Rukevwe Inikori": rukevwe,
  "Puneet Sidhu": puneet,
  "Amel Sassi": amel,
  "Sampada Bodkhe": sampada,
  "Anjali Sankar": anjali,
  "Shrivani Pandiya": shrivani,
  "Roberta Buiani": roberta,
  "Néma McGlynn": nema,
};
---

<SectionLayout title="Workshops" id="workshops">
  <svg
    slot="background"
    class="absolute left-1/2 top-0 h-full w-screen -translate-x-1/2"
    viewBox="0 0 1440 980"
    preserveAspectRatio="none"
  >
    <path
      fill="#f4ebfb"
      d="M0 280 L70 160 L120 210 L190 70 L250 180 L320 40 L390 150 L470 20 L540 140 L630 50 L710 170 L790 30 L870 160 L960 60 L1040 180 L1130 40 L1210 150 L1300 80 L1440 190 L1440 980 L0 980 Z"
    ></path>
    <path
      fill="#eadcf8"
      d="M0 460 L90 280 L160 360 L250 220 L340 390 L450 200 L540 370 L660 180 L760 340 L880 160 L980 330 L1100 190 L1220 360 L1340 230 L1440 320 L1440 980 L0 980 Z"
    ></path>
    <path
      fill="#e3d2f6"
      d="M0 640 L80 480 L170 580 L280 420 L390 560 L520 380 L640 540 L760 360 L880 530 L1020 400 L1160 560 L1280 430 L1440 520 L1440 980 L0 980 Z"
    ></path>
  </svg>
  <p class="max-w-3xl text-[0.98rem] leading-7 text-ink/90">
    Workshops are a wonderful way for you to more actively take part in the
    Conference! Our demos, activities, and guided discussions are designed to
    allow you to get exposure to new concepts, develop useful skills, and engage
    with fellow attendees. With the focus being more on skill-building, we
    believe that everyone will be able to find something useful and inspiring
    from attending these workshops, no matter where their interests lie. Unless
    indicated otherwise, no materials are required for the workshops.
  </p>

  <div class="mt-12 space-y-16">
    {
      workshopGroups.map((group, index) => (
        <article class="grid items-start gap-8 md:grid-cols-2 md:gap-10 lg:gap-14">
          <div class:list={[index % 2 === 1 && "md:order-2"]}>
            <h3 class="font-serif text-2xl font-medium text-ink">{group.title}</h3>
            <p class="mt-4 max-w-xl text-[0.95rem] leading-7 text-ink/90">
              {group.description}
            </p>
          </div>
          <div
            class:list={[
              "grid w-max max-w-full grid-cols-2 gap-x-6 gap-y-8",
              index % 2 === 1 ? "md:order-1 md:justify-self-start" : "md:justify-self-end",
            ]}
          >
            {group.hosts.map((host) => (
              <PersonCard
                name={host.name}
                title={host.title}
                image={images[host.name]}
                bio={host.bio}
                preferredName={host.preferredName}
                objectPosition={host.objectPosition}
              />
            ))}
          </div>
        </article>
      ))
    }
  </div>
</SectionLayout>
