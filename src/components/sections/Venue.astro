---
import SectionLayout from "../../layouts/SectionLayout.astro";
---

<SectionLayout title="Venue">
	<div class="grid gap-8 lg:grid-cols-[1fr_1.2fr]">
		<article class="rounded-2xl border border-blue-navy/10 bg-white p-6 shadow-sm">
			<h3 class="text-2xl font-semibold text-blue-navy">The Westin Harbour Castle, Toronto</h3>
			<p class="mt-3 text-base leading-7 text-blue-navy/85">
				WISE National Conference 2026 will be hosted at the Toronto Westin Harbour Castle,
				with sessions and activities running across both conference days.
			</p>

			<dl class="mt-5 space-y-3 text-sm text-blue-navy/85">
				<div>
					<dt class="font-semibold text-purple-primary">Address</dt>
					<dd>1 Harbour Square, Toronto, ON M5J 1A6</dd>
				</div>
				<div>
					<dt class="font-semibold text-purple-primary">Transit</dt>
					<dd>Accessible by TTC and GO Transit with nearby downtown connections.</dd>
				</div>
				<div>
					<dt class="font-semibold text-purple-primary">Parking</dt>
					<dd>Nearby public lots and hotel valet parking options are available.</dd>
				</div>
			</dl>
		</article>

		<div class="overflow-hidden rounded-2xl border border-blue-navy/10 shadow-sm">
			<iframe
				title="Westin Harbour Castle Map"
				src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2887.335669078258!2d-79.37879222379799!3d43.641184153207945!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89d4cb2a3431ec1f%3A0xc9c3571760440328!2sThe%20Westin%20Harbour%20Castle%2C%20Toronto!5e0!3m2!1sen!2sus!4v1694741687512!5m2!1sen!2sus"
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
				class="h-[360px] w-full border-0 md:h-[440px]"
			></iframe>
		</div>
	</div>
</SectionLayout>