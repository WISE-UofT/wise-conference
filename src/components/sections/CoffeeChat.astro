---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SectionLayout from "../../layouts/SectionLayout.astro";
import PersonCard from "../speakers/PersonCard.astro";
import PersonGrid from "../speakers/PersonGrid.astro";
import { coffeeChatMentors } from "../../content/coffee-chat/mentors";
import ania from "../../assets/speakers/ania-harlick.webp";
import rebecca from "../../assets/panels/Global _ Rebecca Alcock.jpg";
import coffeeChatEllipseLeft from "../../assets/illustrations/coffee-chat-ellipse-left.svg";
import coffeeChatEllipseTop from "../../assets/illustrations/coffee-chat-ellipse-top.svg";
import coffeeChatPath from "../../assets/illustrations/coffee-chat-path.svg";

const uploaded = import.meta.glob<ImageMetadata>(
  "../../assets/coffee chat/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG}",
  { eager: true, import: "default" }
);

const fallbacks: Record<string, ImageMetadata> = {
  "Ania Harlick": ania,
  "Rebecca Alcock": rebecca,
};

function uploadedFor(name: string) {
  const lower = name.toLowerCase();
  const first = lower.split(" ")[0];
  const last = lower.split(" ").at(-1)!;
  const hit = Object.entries(uploaded).find(([path]) => {
    const file = path.split(/[/\\]/).pop()!.toLowerCase();
    return (
      file.includes(lower) ||
      file.includes(last) ||
      file.includes(`- ${first}.`) ||
      file.includes(` ${first}.`)
    );
  });
  return hit?.[1] ?? fallbacks[name];
}
---

<SectionLayout title="Coffee Chat" id="coffee-chat">
  <div
    slot="background"
    class="absolute inset-y-0 left-1/2 w-screen -translate-x-1/2 overflow-hidden bg-[#fffaf6]"
  >
    <Image
      src={coffeeChatEllipseLeft}
      alt=""
      class="pointer-events-none absolute top-[49.6%] left-[-4%] h-[67.6%] w-[55.2%] max-w-none"
      aria-hidden="true"
    />
    <Image
      src={coffeeChatEllipseTop}
      alt=""
      class="pointer-events-none absolute top-[-2.2%] left-[20.2%] h-[61.9%] w-[80.6%] max-w-none rotate-180"
      aria-hidden="true"
    />
    <Image
      src={coffeeChatPath}
      alt=""
      class="pointer-events-none absolute top-[-4.6%] left-[-31%] h-[115.2%] w-[146.2%] max-w-none"
      aria-hidden="true"
    />
  </div>

  <p class="max-w-3xl text-[0.98rem] leading-7 text-ink/90">
    Sit down with professionals from across science and engineering for small,
    informal conversations about their work and career paths.
  </p>

  <PersonGrid
    count={coffeeChatMentors.length}
    width="full"
    class="mt-10 gap-y-10 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5"
  >
    {
      coffeeChatMentors.map((mentor) => (
        <PersonCard
          name={mentor.name}
          title={mentor.title}
          bio={mentor.bio}
          image={uploadedFor(mentor.name)}
          dialogPrefix="coffee-chat"
        />
      ))
    }
  </PersonGrid>
</SectionLayout>
