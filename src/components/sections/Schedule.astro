---
import SectionLayout from "../../layouts/SectionLayout.astro";
import scheduleData from "../../content/schedule/schedule-content.json";

type EventType =
  "general" | "keynote" | "panel" | "workshop" | "competition" | "special";

const typeStyles: Record<EventType, string> = {
  general: "bg-gray-200 text-blue-navy",
  keynote: "bg-blue-navy/80 text-white",
  panel: "bg-purple-primary/20 text-purple-dark",
  workshop: "bg-purple-primary/35 text-purple-dark",
  competition: "bg-purple-primary/50 text-purple-dark",
  special: "bg-blue-navy/80 text-white",
};

const typeLabels: Record<EventType, string> = {
  general: "General",
  keynote: "Keynote",
  panel: "Panel",
  workshop: "Workshop",
  competition: "Competition",
  special: "Special",
};

const schedule = scheduleData as {
  day: string;
  date: string;
  blocks: {
    time: string;
    events: { title: string; location: string; type: EventType }[];
  }[];
}[];
---

<SectionLayout title="Schedule">
  <p
    class="mb-8 text-sm text-center font-semibold uppercase tracking-[0.2em] text-blue-navy/50"
  >
    All times are in Eastern Standard Time (EST)
  </p>

  <div class="grid gap-6 lg:grid-cols-2">
    {
      schedule.map((day) => (
        <article class="rounded-2xl border border-blue-navy/10 bg-white p-6 shadow-sm">
          <p class="text-sm font-semibold uppercase tracking-[0.2em] text-purple-primary">
            {day.day}
          </p>
          <h3 class="mt-1 text-2xl font-semibold text-blue-navy">{day.date}</h3>

          <ol class="mt-5 space-y-3">
            {day.blocks.map((block) => (
              <li>
                <p class="mt-5 mb-2 text-base font-semibold text-blue-navy/70">
                  {block.time}
                </p>
                <ul class="space-y-3">
                  {block.events.map((event) => (
                    <li
                      class={`flex items-start gap-3 rounded-xl px-4 py-3 ${typeStyles[event.type]}`}
                    >
                      <div>
                        <p class="text-base font-semibold leading-snug">
                          {event.title}
                        </p>
                        <p class="mt-1 text-sm font-medium opacity-90">
                          {event.type === "general"
                            ? event.location
                            : `${typeLabels[event.type]} • ${event.location}`}
                        </p>
                      </div>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
        </article>
      ))
    }
  </div>
</SectionLayout>
