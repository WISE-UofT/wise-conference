---
import SectionLayout from "../../layouts/SectionLayout.astro";
import SpeakerRow from "../speakers/SpeakerRow.astro";
import panels from "../../content/speakers/panels-content.json";
---

<SectionLayout title="Speakers">
  <div
    class="text-center mb-8 text-base mx-auto max-w-4xl leading-7 text-blue-navy/85"
  >
    There will be 2 keynotes and 4-6 speakers at each panel. Stay tuned as we
    announce more speaker details!
  </div>

  {
    panels.map((panel) => (
      <SpeakerRow
        title={panel.title}
        subtitle={panel.subtitle}
        description={panel.description}
        dataSource={panel.dataSource}
      />
    ))
  }
</SectionLayout>
