---
import SectionLayout from "../../layouts/SectionLayout.astro";
import SpeakerRow from "../speakers/SpeakerRow.astro";
import { getCollection } from "astro:content";
import { createPeopleResolver } from "../../lib/people";

const panels = (await getCollection("panels")).sort(
  (a, b) => a.data.order - b.data.order,
);
const resolvePeople = await createPeopleResolver();
---

<SectionLayout title="Speakers">
  <div
    class="text-center mb-8 text-base mx-auto max-w-4xl leading-7 text-blue-navy/85"
  >
    There will be 2 keynotes and 4-6 speakers at each panel. Stay tuned as we
    announce more speaker details!
  </div>

  {
    panels.map(({ data: panel }) => (
      <SpeakerRow
        title={panel.title}
        subtitle={panel.subtitle}
        description={panel.description}
        speakers={resolvePeople(panel.participants)}
      />
    ))
  }
</SectionLayout>
