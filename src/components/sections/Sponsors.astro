---
import type { ImageMetadata } from "astro";
import SectionLayout from "../../layouts/SectionLayout.astro";
import SponsorSection from "../sponsors/SponsorSection.astro";
import sponsorsData from "../../content/sponsors/sponsors.json";

const sizeLarge = "max-w-80 sm:max-w-80";
const sizeMedium = "max-w-50 sm:max-w-50";
const sizeSmall = "max-w-40 sm:max-w-40";

const sizeMap: Record<string, string> = {
  large: sizeLarge,
  medium: sizeMedium,
  small: sizeSmall,
};

const toLogoList = (
  entries: { fileName: string; size: string; breakAfter?: boolean }[],
) =>
  entries.map(({ fileName, size, breakAfter = false }) => ({
    fileName,
    sizeClass: sizeMap[size] ?? sizeMedium,
    breakAfter,
  }));

const corporateSponsors = toLogoList(sponsorsData.corporateSponsors);
const academicSponsors = toLogoList(sponsorsData.academicSponsors);
const academicContributors = toLogoList(sponsorsData.academicContributors);

const corporateSponsorImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/sponsors/corporate/*.{webp,png,svg}",
  { eager: true },
);

const academicSponsorImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/sponsors/academic/*.{webp,png,svg}",
  { eager: true },
);
---

<SectionLayout title="Sponsors">
  <p class="mb-8 text-base text-center text-blue-navy/80">
    Want to sponsor the WISE National Conference? Reach out at
    <a
      class="font-semibold text-purple-primary"
      href="mailto:vp.finance@wise.skule.ca">vp.finance@wise.skule.ca</a
    >.
  </p>

  <div class="space-y-10">
    <SponsorSection
      title="Corporate Partners"
      logos={corporateSponsors}
      basePath="../../assets/sponsors/corporate"
      images={corporateSponsorImages}
    />

    <SponsorSection
      title="Academic Sponsors"
      logos={academicSponsors}
      basePath="../../assets/sponsors/academic"
      images={academicSponsorImages}
    />

    <SponsorSection
      title="Academic Contributors"
      logos={academicContributors}
      basePath="../../assets/sponsors/academic"
      images={academicSponsorImages}
    />
  </div>
</SectionLayout>
