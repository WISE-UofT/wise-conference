---
import { Image } from "astro:assets";
import SectionLayout from "../../layouts/SectionLayout.astro";
import birchhill from "../../assets/sponsors/corporate/birchhill.webp";
import amd from "../../assets/sponsors/corporate/amd.webp";
import qualcomm from "../../assets/sponsors/corporate/qualcomm.webp";
import intact from "../../assets/sponsors/corporate/intact.webp";
import arcadis from "../../assets/sponsors/corporate/arcadis.webp";
import amazon from "../../assets/sponsors/corporate/amazon_robotics.webp";
import cascades from "../../assets/sponsors/corporate/cascades.webp";
import waterlooEngineering from "../../assets/sponsors/academic/waterloo-engineering.webp";
import york from "../../assets/sponsors/academic/york-eng.webp";
import tmuGraduate from "../../assets/sponsors/academic/tmu-ysgps-math.png";
import oztrekk from "../../assets/sponsors/academic/oztrekk.webp";
import utmImi from "../../assets/sponsors/academic/utm-imi.png";
import sgu from "../../assets/sponsors/academic/sgu.png";
import mcgillScience from "../../assets/sponsors/academic/mcgill-science.png";
import mcmasterWie from "../../assets/sponsors/academic/mcmaster-wie.webp";
import uofgWie from "../../assets/sponsors/academic/uofg-wie.png";
import tmuArchDesEng from "../../assets/sponsors/academic/tmu-arch-des-eng.webp";
import utmOvpad from "../../assets/sponsors/academic/utm-ovpad.webp";
import uoftArtSci from "../../assets/sponsors/academic/uoft-art-sci.webp";
import uoftCompSci from "../../assets/sponsors/academic/uoft-comp-sci.webp";
import uoftChemicalEng from "../../assets/sponsors/academic/uoft-chemical-eng.png";
import uoftEarthSci from "../../assets/sponsors/academic/uoft-earth-sci.webp";
import uoftPharmTox from "../../assets/sponsors/academic/uoft-pharm-tox.webp";
import uoftPhysics from "../../assets/sponsors/academic/uoft-physics.webp";
import uoftMath from "../../assets/sponsors/academic/uoft-math.png";
import uoftEnvironment from "../../assets/sponsors/academic/uoft-environment.png";
import uoftCsb from "../../assets/sponsors/academic/uoft-csb.webp";

const academicContributors = [
  { src: mcgillScience, alt: "McGill University Faculty of Science" },
  { src: mcmasterWie, alt: "McMaster Women in Engineering" },
  { src: uofgWie, alt: "University of Guelph Women in Engineering" },
  {
    src: tmuArchDesEng,
    alt: "Toronto Metropolitan University Faculty of Engineering and Architectural Science",
  },
  {
    src: tmuGraduate,
    alt: "Toronto Metropolitan University Mathematics, Graduate and Postdoctoral Studies",
  },
  {
    src: utmOvpad,
    alt: "University of Toronto Mississauga Office of the Vice-Principal Academic and Dean",
  },
  { src: uoftArtSci, alt: "University of Toronto Faculty of Arts and Science" },
  { src: uoftCompSci, alt: "University of Toronto Computer Science" },
  {
    src: uoftChemicalEng,
    alt: "University of Toronto Chemical Engineering and Applied Chemistry",
  },
  { src: uoftEarthSci, alt: "University of Toronto Earth Sciences" },
  {
    src: uoftPharmTox,
    alt: "University of Toronto Pharmacology and Toxicology",
  },
  { src: uoftPhysics, alt: "University of Toronto Physics" },
  { src: uoftMath, alt: "University of Toronto Mathematics" },
  {
    src: uoftEnvironment,
    alt: "University of Toronto School of the Environment",
  },
  { src: uoftCsb, alt: "University of Toronto Cell and Systems Biology" },
];
---

<SectionLayout title="Conference Sponsors" id="sponsors" align="center">
  <p class="text-center text-base text-ink/80">
    Want to become a sponsor? Get in touch with us at{" "}
    <a
      class="underline decoration-ink/30 underline-offset-2 hover:decoration-ink"
      href="mailto:vp.finance@wise.skule.ca">vp.finance@wise.skule.ca</a
    >!
  </p>

  <h3 class="mt-12 text-center font-serif text-2xl font-medium text-ink">
    Corporate Sponsors
  </h3>

  <div class="mt-8 flex justify-center">
    <Image
      src={birchhill}
      alt="Birch Hill Equity Partners"
      class="h-24 w-auto max-w-full object-contain md:h-32"
    />
  </div>

  <div class="mt-10 flex flex-wrap items-center justify-center gap-x-14 gap-y-8">
    <Image src={amd} alt="AMD" class="h-12 w-auto object-contain md:h-14" />
    <Image
      src={qualcomm}
      alt="Qualcomm"
      class="h-12 w-auto object-contain md:h-14"
    />
  </div>

  <div class="mt-10 flex flex-wrap items-center justify-center gap-x-12 gap-y-8">
    <Image src={intact} alt="Intact" class="h-14 w-auto object-contain" />
    <Image src={arcadis} alt="Arcadis" class="h-12 w-auto object-contain" />
    <Image
      src={amazon}
      alt="Amazon Robotics"
      class="h-14 w-auto object-contain"
    />
  </div>

  <div class="mt-10 flex flex-wrap items-center justify-center gap-x-12 gap-y-8">
    <Image src={cascades} alt="Cascades" class="h-12 w-auto object-contain" />
    <!-- Kinross Gold Corporation -->
    <!-- Kinaxis -->
    <!-- Stantec -->
  </div>

  <h3 class="mt-16 text-center font-serif text-2xl font-medium text-ink">
    Academic Partners
  </h3>

  <!--
    Academic partner row. Drop logos in here; this row stays separate from the one below.
    <div class="mt-8 flex flex-wrap items-center justify-center gap-8 md:gap-12">
    </div>
  -->

  <div class="mt-8 flex flex-wrap items-center justify-center gap-8 md:gap-12">
    <Image
      src={waterlooEngineering}
      alt="University of Waterloo Faculty of Engineering"
      class="h-16 w-auto max-w-64 object-contain"
    />
    <Image
      src={york}
      alt="Lassonde School of Engineering, York University"
      class="h-14 w-auto object-contain"
    />
    <Image
      src={tmuGraduate}
      alt="Toronto Metropolitan University Mathematics, Graduate and Postdoctoral Studies"
      class="h-14 w-auto max-w-72 object-contain"
    />
    <Image
      src={oztrekk}
      alt="OzTrekk"
      class="h-12 w-auto max-w-56 object-contain"
    />
    <Image
      src={utmImi}
      alt="Institute for Management and Innovation, University of Toronto Mississauga"
      class="h-14 w-auto max-w-72 object-contain"
    />
    <Image
      src={sgu}
      alt="St. George's University, Grenada"
      class="h-20 w-auto max-w-48 object-contain"
    />
  </div>
</SectionLayout>

<section class="mx-auto w-full max-w-7xl px-5 pb-8 md:px-8">
  <h3 class="mt-16 text-center font-serif text-2xl font-medium text-ink">
    Academic Contributors
  </h3>

  <div
    class="mt-8 grid grid-cols-2 items-center gap-x-5 gap-y-7 sm:grid-cols-3 lg:grid-cols-4"
  >
    {
      academicContributors.map(({ src, alt }) => (
        <div class="flex h-28 items-center justify-center sm:h-32">
          <Image
            src={src}
            alt={alt}
            class="max-h-full w-full object-contain"
          />
        </div>
      ))
    }
  </div>
</section>
