---
import SectionLayout from "../../layouts/SectionLayout.astro";
import ImageCarousel from "../ui/ImageCarousel.astro";
import Collapsible from "../ui/Collapsible.astro";
import SpeakerRow from "../speakers/SpeakerRow.astro";
import type { ImageMetadata } from "astro";

const recapThemes: Record<string, string> = {
  "2026": "Hidden Depths",
  "2025": "Reaching for the Stars",
  "2024": "Endless Exploration",
  "2023": "Leaders of Tomorrow",
  "2022": "Above and Beyond",
  "2021": "Connections Together from Afar",
  "2020": "Lead without Limits",
  "2019": "Catalysts for Change",
};

type RecapSpeaker = {
  name: string;
  image: string;
  title: string;
  bio?: string;
  pronouns?: string;
};

type RecapSpeakerResolved = Omit<RecapSpeaker, "image"> & {
  image: ImageMetadata | string;
};

const recapImageModules = import.meta.glob(
  "../../assets/recap/*/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp,WEBP,avif,AVIF,gif,GIF}",
  {
    eager: true,
  },
);

const recapSpeakerModules = import.meta.glob("../../content/recap/*.json", {
  eager: true,
});

const recapSpeakerImageModules = import.meta.glob(
  "../../assets/previous-speakers/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp,WEBP,avif,AVIF,gif,GIF}",
  {
    eager: true,
  },
);

type RecapImageItem = {
  image: ImageMetadata;
  sortKey: string;
};

const recapGroupedByYear = Object.entries(recapImageModules).reduce(
  (acc, [path, importedModule]) => {
    const pathParts = path.split("/");
    const year = pathParts[pathParts.length - 2];
    const fileName = pathParts[pathParts.length - 1] ?? path;

    const image = (importedModule as { default: ImageMetadata }).default;

    if (!image) {
      return acc;
    }

    if (!acc[year]) {
      acc[year] = [];
    }

    acc[year].push({ image, sortKey: fileName.toLowerCase() });
    return acc;
  },
  {} as Record<string, RecapImageItem[]>,
);

const recapSpeakersByYear = Object.entries(recapSpeakerModules).reduce(
  (acc, [path, importedModule]) => {
    const pathParts = path.split("/");
    const year = pathParts[pathParts.length - 1]?.replace(".json", "") ?? path;

    const speakers = (importedModule as { default: RecapSpeaker[] }).default;

    acc[year] = [...(acc[year] ?? []), ...(speakers ?? [])];
    return acc;
  },
  {} as Record<string, RecapSpeaker[]>,
);

const recapSpeakerImagesByFileName = Object.fromEntries(
  Object.entries(recapSpeakerImageModules).map(([path, imageMod]) => [
    path.split("/").pop() ?? "",
    (imageMod as { default: ImageMetadata }).default,
  ]),
);

const resolveRecapSpeakerImage = (image: string) => {
  const fileName = image.split("/").pop() ?? image;
  return recapSpeakerImagesByFileName[fileName] ?? image;
};

const recapYears = Object.keys(recapSpeakersByYear)
  .sort((a, b) => Number(b) - Number(a))
  .map((year) => ({
    year,
    theme: recapThemes[year] ?? "WISE Highlights",
    speakers: (recapSpeakersByYear[year] ?? []).map(
      (speaker) =>
        ({
          ...speaker,
          image: resolveRecapSpeakerImage(speaker.image),
        }) satisfies RecapSpeakerResolved,
    ),
    images: (recapGroupedByYear[year] ?? [])
      .sort((a, b) => a.sortKey.localeCompare(b.sortKey))
      .map((image) => image.image),
  }));
---

<SectionLayout title="Recap">
  <div class="space-y-4">
    {
      recapYears.map((recap) => (
        <Collapsible
          title={`WISE Conference ${recap.year} — ${recap.theme}`}
          titleClass="text-base md:text-xl text-purple-dark"
          contentClass="pt-5"
        >
          <div class="space-y-8">
            {recap.images.length > 0 && (
              <ImageCarousel
                images={recap.images}
                labelPrefix={`WISE Conference ${recap.year} Recap Image`}
                slideClass="h-[clamp(300px,58vw,560px)]"
              />
            )}

            <div class="text-center text-2xl font-semibold">
              {recap.year} Keynote Speakers
            </div>

            <SpeakerRow
              title={`WISE Conference ${recap.year} Speakers`}
              subtitle=""
              description=""
              dataSource={recap.year}
              speakers={recap.speakers}
              showHeader={false}
              class="mb-0"
            />
          </div>
        </Collapsible>
      ))
    }
  </div>
</SectionLayout>
