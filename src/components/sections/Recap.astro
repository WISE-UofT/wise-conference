---
import SectionLayout from "../../layouts/SectionLayout.astro";
import ImageCarousel from "../ui/ImageCarousel.astro";
import Collapsible from "../ui/Collapsible.astro";
import type { ImageMetadata } from "astro";

const recapThemes: Record<string, string> = {
  "2026": "Hidden Depths",
  "2025": "Reaching for the Stars",
  "2024": "Endless Exploration",
  "2023": "Leaders of Tomorrow",
  "2022": "Above and Beyond",
  "2021": "Connections Together from Afar",
  "2020": "Lead without Limits",
  "2019": "Catalysts for Change",
};

const recapImageModules = import.meta.glob(
  "../../assets/recap/*/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp,WEBP,avif,AVIF,gif,GIF}",
  {
    eager: true,
  },
);

type RecapImageItem = {
  image: ImageMetadata;
  sortKey: string;
};

const recapGroupedByYear = Object.entries(recapImageModules).reduce(
  (acc, [path, importedModule]) => {
    const pathParts = path.split("/");
    const year = pathParts[pathParts.length - 2];
    const fileName = pathParts[pathParts.length - 1] ?? path;

    const image = (importedModule as { default: ImageMetadata }).default;

    if (!image) {
      return acc;
    }

    if (!acc[year]) {
      acc[year] = [];
    }

    acc[year].push({ image, sortKey: fileName.toLowerCase() });
    return acc;
  },
  {} as Record<string, RecapImageItem[]>,
);

const recapByYear = Object.entries(recapGroupedByYear)
  .map(([year, images]) => ({
    year,
    theme: recapThemes[year] ?? "WISE Highlights",
    images: images
      .sort((a, b) => a.sortKey.localeCompare(b.sortKey))
      .map((image) => image.image),
  }))
  .sort((a, b) => Number(b.year) - Number(a.year));
---

<SectionLayout title="Recap">
  <div class="space-y-4">
    {
      recapByYear.map((recap) => (
        <Collapsible
          title={`WISE Conference ${recap.year} — ${recap.theme}`}
          titleClass="text-xl text-purple-dark"
          contentClass="pt-5"
        >
          <ImageCarousel
            images={recap.images}
            labelPrefix={`WISE Conference ${recap.year} Recap Image`}
          />
        </Collapsible>
      ))
    }
  </div>
</SectionLayout>
