---
import { Image } from "astro:assets";
import path from "../../assets/hero/path.svg";
import group from "../../assets/gallery/group.jpg";
import posters from "../../assets/gallery/posters.jpg";
import audience from "../../assets/gallery/audience.jpg";
import roundtables from "../../assets/gallery/roundtables.jpg";
import registration from "../../assets/gallery/registration.jpg";
import laptops from "../../assets/gallery/workshop-laptops.jpg";
import stage from "../../assets/gallery/stage.jpg";
import stageScreens from "../../assets/gallery/stage-screens.jpg";
import booth from "../../assets/gallery/booth.jpg";
---

<section
  id="overview"
  aria-label="About the conference"
  class="relative -mt-px overflow-hidden bg-[linear-gradient(180deg,#fdcae9_0%,#fde4f2_45%,#ffffff_100%)] font-spartan"
>
  <Image
    src={path}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute top-0 left-[19.5%] h-auto w-[80.5%]"
    style="mask-image: linear-gradient(to bottom, black 0%, black 72%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 0%, black 72%, transparent 100%);"
  />

  <div class="relative mx-auto grid w-full max-w-[1800px] grid-cols-2 items-start gap-4 px-5 pt-10 pb-12 sm:gap-6 sm:px-8 lg:block lg:aspect-[1512/1203] lg:p-0">
    <div
      class="col-span-2 max-w-3xl space-y-4 text-base leading-relaxed text-ink sm:text-lg lg:absolute lg:top-[22%] lg:left-[9%] lg:w-[31%] lg:max-w-none lg:space-y-3 lg:text-[clamp(0.9rem,1.05vw,1.125rem)] lg:leading-[1.42]"
    >
      <p>
        Women in Science and Engineering is proud to present to you our
        15th Annual National Conference on January 23-24, 2027 from 9
        AM to 5:30 PM! The WISE National Conference serves as a catalyst to
        inspire and empower individuals to pursue their passions, broaden their
        horizons, and form meaningful connections.
      </p>
      <p>
        This year’s theme, <strong>Breaking New Ground,</strong> is a celebration
        of the courage it takes to step beyond the familiar and into the
        unknown. This theme honours individuals who forge new paths in
        underrepresented fields, challenge expectations, and expand the horizon
        of what’s possible. By blazing trails today, they are not only
        redefining what success can look like, but they are also creating new
        possibilities and paving the way for future generations.
      </p>
      <p>
        The conference brings delegates together from across Canada to
        share ideas and become inspired over the course of two days, dedicated
        to professional and personal growth. Delegates will have the opportunity
        to hear from inspirational leaders across a wide range of STEM fields, expand their skillsets through
        technical and professional development workshops, and challenge
        themselves in various competitions. The National Conference aims to
        inspire and empower delegates to realize their potential and catalyze
        change within their communities.
      </p>
    </div>

    <Image
      src={group}
      alt="WISE National Conference group photo on stage with silver balloons"
      class="col-span-2 aspect-[721/398] w-full object-cover lg:absolute lg:top-[18.55%] lg:left-[48.6%] lg:h-[33.1%] lg:w-[47.7%]"
    />
    <div class="col-span-2 columns-2 gap-4 sm:gap-6 lg:contents">
      <Image
        src={registration}
        alt="Attendees with tote bags by the windows"
        class="mb-4 aspect-[283/167] w-full break-inside-avoid object-cover sm:mb-6 lg:absolute lg:top-[55.38%] lg:left-[40.74%] lg:mb-0 lg:h-[13.88%] lg:w-[18.72%]"
      />
      <Image
        src={stage}
        alt="A speaker at the podium on the main stage"
        class="mb-4 aspect-[208/270] w-full break-inside-avoid object-cover sm:mb-6 lg:absolute lg:top-[55.38%] lg:left-[63.43%] lg:mb-0 lg:h-[22.44%] lg:w-[13.76%]"
      />
      <Image
        src={laptops}
        alt="Hands-on workshop with laptops and a live coding demo"
        class="mb-4 aspect-[248/270] w-full break-inside-avoid object-cover sm:mb-6 lg:absolute lg:top-[55.38%] lg:left-[79.89%] lg:mb-0 lg:h-[22.44%] lg:w-[16.4%]"
      />
      <Image
        src={roundtables}
        alt="Workshop attendees working at round tables"
        class="mb-4 aspect-[283/168] w-full break-inside-avoid object-cover sm:mb-6 lg:absolute lg:top-[68.43%] lg:left-[17.66%] lg:mb-0 lg:h-[13.97%] lg:w-[18.72%]"
      />
      <Image
        src={stageScreens}
        alt="The ballroom from the back, with the session screens on stage"
        class="mb-4 aspect-[373/167] w-full break-inside-avoid object-cover sm:mb-6 lg:absolute lg:top-[86.05%] lg:left-[11.71%] lg:mb-0 lg:h-[13.88%] lg:w-[24.67%]"
      />
      <Image
        src={audience}
        alt="Audience seated by the windows during a session"
        class="mb-4 aspect-[283/332] w-full break-inside-avoid object-cover sm:mb-6 lg:absolute lg:top-[72.25%] lg:left-[40.01%] lg:mb-0 lg:h-[27.6%] lg:w-[18.72%]"
      />
      <Image
        src={booth}
        alt="Attendees at a sponsor booth by the windows"
        class="mb-4 aspect-[169/219] w-full break-inside-avoid object-cover sm:mb-6 lg:absolute lg:top-[81.64%] lg:left-[61.9%] lg:mb-0 lg:h-[18.2%] lg:w-[11.18%]"
      />
      <Image
        src={posters}
        alt="Attendees discussing research posters"
        class="mb-4 aspect-[317/187] w-full break-inside-avoid object-cover sm:mb-6 lg:absolute lg:top-[84.39%] lg:left-[75.33%] lg:mb-0 lg:h-[15.54%] lg:w-[20.97%]"
      />
    </div>
  </div>
</section>
