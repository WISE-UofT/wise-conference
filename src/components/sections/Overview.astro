---
import SectionLayout from "../../layouts/SectionLayout.astro";

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import team from "../../assets/recap/2026/team.webp";

const recapImages = Object.entries(
	import.meta.glob("../../assets/recap/2026/*.{png,jpg,jpeg,webp,avif}", {
		eager: true,
	}),
)
	.map(([path, module]) => ({
		path,
		src: (module as { default: ImageMetadata }).default,
	}))
	.sort((a, b) => a.path.localeCompare(b.path));
---

<SectionLayout title="Overview">
	<div class="space-y-8">
		<Image class="rounded-2xl" src={team} alt="WISE 2026 team" />
		<p
			class="text-lg text-center max-w-4xl mx-auto leading-8 text-blue-navy/90"
		>
			Women in Science and Engineering proudly presented our <span
				class="font-semibold">14th Annual WISE National Conference</span
			>
			on January 17-18, 2026. Thank you to everyone who helped make the event a huge
			success. Check out some snapshots from the conference and we look forward to
			seeing you in 2027!
		</p>
		<div class="mx-auto grid w-full max-w-4xl gap-3" data-carousel>
			<div
				class="overflow-hidden rounded-2xl border border-blue-navy/12 shadow-[0_10px_25px_rgb(16_31_70/0.08)]"
			>
				<div
					class="flex transition-transform duration-420 ease-out will-change-transform"
					data-carousel-track
				>
					{
						recapImages.map((image, index) => (
							<div class="h-[clamp(220px,48vw,420px)] w-full min-w-full">
								<Image
									src={image.src}
									alt={`WISE conference recap image ${index + 1}`}
									class="h-full w-full object-cover"
									loading="lazy"
								/>
							</div>
						))
					}
				</div>
			</div>
			<div
				class="flex items-center justify-between gap-3 max-sm:justify-center"
			>
				<button
					type="button"
					class="rounded-full border border-blue-navy/25 bg-white px-3.5 py-1.5 text-[0.8rem] font-bold tracking-[0.02em] text-blue-navy transition hover:border-blue-navy/45 hover:bg-blue-navy/6 max-sm:hidden"
					data-carousel-prev
					aria-label="Previous recap image"
				>
					Prev
				</button>
				<div class="flex flex-wrap justify-center gap-2" data-carousel-dots>
					{
						recapImages.map((_, index) => (
							<button
								type="button"
								class="h-2.5 w-2.5 rounded-full bg-blue-navy/20 p-0"
								data-carousel-dot
								data-index={index}
								aria-label={`Go to recap image ${index + 1}`}
							/>
						))
					}
				</div>
				<button
					type="button"
					class="rounded-full border border-blue-navy/25 bg-white px-3.5 py-1.5 text-[0.8rem] font-bold tracking-[0.02em] text-blue-navy transition hover:border-blue-navy/45 hover:bg-blue-navy/6 max-sm:hidden"
					data-carousel-next
					aria-label="Next recap image"
				>
					Next
				</button>
			</div>
		</div>
		<!-- <div class="flex flex-wrap gap-3 pt-2">
				<a
					href="https://www.zeffy.com/en-CA/ticketing/wise-national-conference--2026-2"
					target="_blank"
					rel="noreferrer"
					class="rounded-full bg-blue-navy px-6 py-3 text-sm font-semibold tracking-wide text-white transition hover:bg-purple-primary"
				>
					Buy Tickets
				</a>
			</div> -->

		<!-- Countdown -->
		<!-- <aside class="rounded-2xl bg-blue-navy p-6 text-white shadow-xl">
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-purple-light">Conference Starts In</p>
			<div id="countdown-box" class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
				<div class="rounded-xl bg-white/10 p-3 text-center">
					<p id="countdown-days" class="text-2xl font-bold">0</p>
					<p class="text-xs uppercase tracking-wide text-purple-light">Days</p>
				</div>
				<div class="rounded-xl bg-white/10 p-3 text-center">
					<p id="countdown-hours" class="text-2xl font-bold">0</p>
					<p class="text-xs uppercase tracking-wide text-purple-light">Hours</p>
				</div>
				<div class="rounded-xl bg-white/10 p-3 text-center">
					<p id="countdown-minutes" class="text-2xl font-bold">0</p>
					<p class="text-xs uppercase tracking-wide text-purple-light">Minutes</p>
				</div>
				<div class="rounded-xl bg-white/10 p-3 text-center">
					<p id="countdown-seconds" class="text-2xl font-bold">0</p>
					<p class="text-xs uppercase tracking-wide text-purple-light">Seconds</p>
				</div>
			</div>
		</aside> -->
	</div>

	<script>
		/*
		const targetDate = new Date("2026-01-17T08:00:00-05:00").getTime();
		const days = document.getElementById("countdown-days");
		const hours = document.getElementById("countdown-hours");
		const minutes = document.getElementById("countdown-minutes");
		const seconds = document.getElementById("countdown-seconds");

		function updateCountdown() {
			const now = Date.now();
			const diff = Math.max(targetDate - now, 0);

			const dayValue = Math.floor(diff / (1000 * 60 * 60 * 24));
			const hourValue = Math.floor((diff / (1000 * 60 * 60)) % 24);
			const minuteValue = Math.floor((diff / (1000 * 60)) % 60);
			const secondValue = Math.floor((diff / 1000) % 60);

			if (days) days.textContent = String(dayValue);
			if (hours) hours.textContent = String(hourValue);
			if (minutes) minutes.textContent = String(minuteValue);
			if (seconds) seconds.textContent = String(secondValue);
		}

		updateCountdown();
		window.setInterval(updateCountdown, 1000);
		*/

		const carousels = document.querySelectorAll<HTMLElement>("[data-carousel]");

		carousels.forEach((carousel) => {
			const track = carousel.querySelector<HTMLElement>(
				"[data-carousel-track]",
			);
			const prevButton = carousel.querySelector<HTMLButtonElement>(
				"[data-carousel-prev]",
			);
			const nextButton = carousel.querySelector<HTMLButtonElement>(
				"[data-carousel-next]",
			);
			const dots = Array.from(
				carousel.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]"),
			);

			if (!track || !prevButton || !nextButton || dots.length === 0) {
				return;
			}

			const slideCount = dots.length;
			let currentIndex = 0;
			let autoplayId: number | undefined;

			const updateCarousel = () => {
				track.style.transform = `translateX(-${currentIndex * 100}%)`;
				dots.forEach((dot, index) => {
					dot.setAttribute(
						"aria-current",
						index === currentIndex ? "true" : "false",
					);
					dot.classList.toggle("bg-purple-primary", index === currentIndex);
					dot.classList.toggle("bg-blue-navy/20", index !== currentIndex);
				});
			};

			const goTo = (nextIndex: number) => {
				currentIndex = (nextIndex + slideCount) % slideCount;
				updateCarousel();
			};

			const startAutoplay = () => {
				if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
					return;
				}
				autoplayId = window.setInterval(() => goTo(currentIndex + 1), 5000);
			};

			const stopAutoplay = () => {
				if (autoplayId) {
					window.clearInterval(autoplayId);
					autoplayId = undefined;
				}
			};

			prevButton.addEventListener("click", () => {
				stopAutoplay();
				goTo(currentIndex - 1);
				startAutoplay();
			});

			nextButton.addEventListener("click", () => {
				stopAutoplay();
				goTo(currentIndex + 1);
				startAutoplay();
			});

			dots.forEach((dot) => {
				dot.addEventListener("click", () => {
					const index = Number(dot.dataset.index ?? "0");
					stopAutoplay();
					goTo(index);
					startAutoplay();
				});
			});

			updateCarousel();
			startAutoplay();
		});
	</script>
</SectionLayout>
