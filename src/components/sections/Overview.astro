---
import SectionLayout from "../../layouts/SectionLayout.astro";
import ImageCarousel from "../ui/ImageCarousel.astro";

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import team from "../../assets/recap/2026/team.webp";

const recapImages = Object.entries(
  import.meta.glob("../../assets/recap/2026/*.{png,jpg,jpeg,webp,avif}", {
    eager: true,
  }),
)
  .map(([path, module]) => ({
    path,
    src: (module as { default: ImageMetadata }).default,
  }))
  .sort((a, b) => a.path.localeCompare(b.path));
---

<SectionLayout title="Overview">
  <div class="space-y-8">
    <Image class="rounded-2xl" src={team} alt="WISE 2026 team" />
    <p
      class="text-lg text-center max-w-4xl mx-auto leading-8 text-blue-navy/90"
    >
      Women in Science and Engineering proudly presented our <span
        class="font-semibold">14th Annual WISE National Conference</span
      >
      on January 17-18, 2026. Thank you to everyone who helped make the event a huge
      success. Check out some snapshots from the conference and we look forward to
      seeing you in 2027!
    </p>
    <ImageCarousel
      images={recapImages.map((image) => image.src)}
      labelPrefix="WISE Conference 2026 Recap Image"
    />
