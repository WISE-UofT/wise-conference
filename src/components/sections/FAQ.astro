---
import SectionLayout from "../../layouts/SectionLayout.astro";
import Collapsible from "../ui/Collapsible.astro";
import faqs from "../../content/faqs/faqs-content.json";
---

<SectionLayout title="FAQ">
  <div class="space-y-3">
    {
      faqs.map((faq) => (
        <Collapsible title={faq.question} content={faq.answer} />
      ))
    }
  </div>
</SectionLayout>
