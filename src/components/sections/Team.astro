---
import { getCollection } from "astro:content";
import { createPeopleResolver } from "../../lib/people";
import TeamMember from "../team/TeamMember.astro";

const team = (await getCollection("team"))[0];
const resolvePeople = await createPeopleResolver();
const teamMembers = team ? resolvePeople(team.data.members) : [];
---

<section id="team" class="w-full py-12 md:py-16">
  <div class="mx-auto w-full max-w-7xl px-4 md:px-8">
    <h2 class="mb-8 text-center text-3xl font-bold tracking-tight md:text-4xl">
      Our Team
    </h2>

    <div
      class="grid grid-cols-2 gap-5 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5"
    >
      {
        teamMembers.map((member) => (
          <TeamMember
            imagePath={member.image}
            name={member.name}
            position={member.role}
          />
        ))
      }
    </div>
  </div>
</section>
