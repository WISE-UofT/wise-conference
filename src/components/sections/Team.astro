---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import mountains from "../../assets/hero/mountains.png";

const teamImages = import.meta.glob<ImageMetadata>(
  "../../assets/team/2027/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG}",
  { eager: true, import: "default" }
);

function titleCase(value: string) {
  return value
    .split(/(\s+|-)/)
    .map((part) => {
      if (part === "-" || /^\s+$/.test(part)) return part;
      if (part.toLowerCase() === "of") return "of";
      return part.charAt(0).toUpperCase() + part.slice(1).toLowerCase();
    })
    .join("")
    .replace(/\s+/g, " ")
    .trim();
}

const roleOrder = [
  "Co-Chair",
  "Director of Operations",
  "Director of Panels",
  "Director of Marketing",
  "Director of Competitions",
  "Director of Outreach",
  "Conference Webmaster",
  "Workshops",
  "First Year Rep",
];

const team = Object.entries(teamImages)
  .map(([path, image]) => {
    const file = path.split(/[/\\]/).pop()!.replace(/\.[^.]+$/, "");
    const [rawName, rawRole = ""] = file.split(/\s+-\s+/);
    return {
      name: rawName
        .replace(/_/g, " ")
        .replace(/([a-z])([A-Z])/g, "$1 $2")
        .replace(/\s+/g, " ")
        .trim(),
      position: titleCase(rawRole),
      image,
    };
  })
  .sort((a, b) => {
    const rank = (role: string) => {
      const index = roleOrder.indexOf(role);
      return index < 0 ? roleOrder.length : index;
    };
    return rank(a.position) - rank(b.position) || a.name.localeCompare(b.name);
  });
---

<section id="team" class="relative mt-6 overflow-hidden bg-gradient-to-b from-[#fef3ec] via-[#fde8f0] to-[#f6e4f4] pt-8">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-[#fff7f2] to-[#fef3ec]"
    aria-hidden="true"
  >
  </div>
  <p class="relative z-10 mb-4 text-center text-sm text-ink/80">
    Made with love &lt;3
  </p>
  <p class="relative z-10 mb-4 text-center text-sm text-ink/80">
    Supported by the{" "}
    <a
      href="https://wise.skule.ca/team"
      class="underline decoration-ink/30 underline-offset-2 hover:decoration-ink"
    >WISE UofT team</a>
  </p>

  <div
    class="team-curve relative z-10 h-[23rem] w-full cursor-grab touch-pan-y overflow-hidden select-none active:cursor-grabbing"
    data-team-curve
    role="region"
    aria-label="Conference team carousel. Swipe or drag horizontally to browse."
    tabindex="0"
  >
    {
      team.map((member) => (
        <article class="team-polaroid absolute top-3 left-0 w-[8.5rem] bg-white px-2 pt-2 pb-3 shadow-[0_10px_24px_rgba(58,49,82,0.14)]">
          <span
            class="absolute -top-2 left-1/2 h-3.5 w-6 -translate-x-1/2 rounded-sm bg-ink/75"
            aria-hidden="true"
          />
          <Image
            src={member.image}
            alt={member.name || "Conference team member"}
            class="aspect-[4/5] w-full object-cover object-top"
            width={280}
            height={350}
            draggable={false}
          />
          {member.name && (
            <p class="mt-1.5 text-center text-xs font-bold leading-tight text-ink">
              {member.name}
            </p>
          )}
          {member.position && (
            <p class="text-center text-[0.65rem] leading-tight text-ink/60">
              {member.position}
            </p>
          )}
        </article>
      ))
    }
  </div>

  <div class="relative mt-2">
    <div
      class="pointer-events-none absolute inset-x-0 bottom-full h-64 sm:h-80"
      style="background: linear-gradient(to bottom, rgba(247,249,254,0) 0%, #f8f6fe 10%, #fff7f2 30%, #fef3ec 50%, #fdeeea 66%, #fde8f0 80%, #f6e4f4 92%, #f6e4f4 100%)"
      aria-hidden="true"
    >
    </div>
    <div class="relative aspect-[1024/420] w-full overflow-hidden">
      <Image
        src={mountains}
        alt=""
        class="absolute inset-0 h-full w-full object-cover object-bottom"
      />
      <div
        class="pointer-events-none absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-[#f6e4f4] via-[#f6e4f4]/70 to-transparent"
        aria-hidden="true"
      >
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-team-curve]");
  if (root) {
    const cards = [...root.querySelectorAll<HTMLElement>(".team-polaroid")];
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let offset = 0;
    let hoveredCard = false;
    let dragging = false;
    let activePointer: number | null = null;
    let startPointerX = 0;
    let startPointerY = 0;
    let lastPointerX = 0;
    let dragAxis: "x" | "y" | null = null;
    let resumeAt = 0;
    const speed = 0.55;
    const resumeDelay = 900;

    const place = () => {
      const stageW = root.clientWidth;
      const cardW = cards[0]?.offsetWidth ?? 136;
      const spacing = cardW + 28;
      const loop = Math.max(cards.length * spacing, stageW + spacing);

      cards.forEach((card, index) => {
        let x = index * spacing - offset;
        x = ((x % loop) + loop) % loop;
        if (x > stageW + cardW) x -= loop;

        const t = (x + cardW / 2) / stageW;
        const along = Math.min(1, Math.max(0, t));
        const y = Math.sin(along * Math.PI) * 46;
        const rot = (0.5 - along) * 8;
        card.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${rot}deg)`;
      });
    };

    const pauseTemporarily = () => {
      resumeAt = performance.now() + resumeDelay;
    };

    const tick = () => {
      const canAutoplay =
        !hoveredCard &&
        !dragging &&
        performance.now() >= resumeAt &&
        !reduced &&
        document.visibilityState !== "hidden";

      if (canAutoplay) {
        offset += speed;
      }
      place();
      requestAnimationFrame(tick);
    };

    cards.forEach((card) => {
      card.addEventListener("mouseenter", () => {
        hoveredCard = true;
      });
      card.addEventListener("mouseleave", () => {
        hoveredCard = false;
      });
    });

    root.addEventListener("pointerdown", (event) => {
      if (event.button !== 0) return;

      dragging = true;
      activePointer = event.pointerId;
      startPointerX = event.clientX;
      startPointerY = event.clientY;
      lastPointerX = event.clientX;
      dragAxis = null;
      root.setPointerCapture(event.pointerId);
    });

    root.addEventListener("pointermove", (event) => {
      if (!dragging || event.pointerId !== activePointer) return;

      const totalX = event.clientX - startPointerX;
      const totalY = event.clientY - startPointerY;
      if (!dragAxis && Math.max(Math.abs(totalX), Math.abs(totalY)) >= 6) {
        dragAxis = Math.abs(totalX) > Math.abs(totalY) ? "x" : "y";
      }
      if (dragAxis !== "x") return;

      event.preventDefault();
      offset -= event.clientX - lastPointerX;
      lastPointerX = event.clientX;
      pauseTemporarily();
      place();
    });

    const finishDrag = (event: PointerEvent) => {
      if (event.pointerId !== activePointer) return;
      dragging = false;
      activePointer = null;
      dragAxis = null;
      pauseTemporarily();
      if (root.hasPointerCapture(event.pointerId)) {
        root.releasePointerCapture(event.pointerId);
      }
    };

    root.addEventListener("pointerup", finishDrag);
    root.addEventListener("pointercancel", finishDrag);
    root.addEventListener("dragstart", (event) => event.preventDefault());

    root.addEventListener(
      "wheel",
      (event) => {
        const delta = event.shiftKey ? event.deltaY : event.deltaX;
        if (Math.abs(delta) < 1) return;

        event.preventDefault();
        offset += delta;
        pauseTemporarily();
        place();
      },
      { passive: false },
    );

    root.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;

      event.preventDefault();
      const cardW = cards[0]?.offsetWidth ?? 136;
      offset += event.key === "ArrowRight" ? cardW + 28 : -(cardW + 28);
      pauseTemporarily();
      place();
    });

    root.dataset.ready = "true";
    tick();
  }
</script>

<style>
  .team-curve:not([data-ready]) .team-polaroid {
    visibility: hidden;
  }
</style>
