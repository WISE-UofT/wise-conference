---
import type { ImageMetadata } from "astro";
import TeamMember from "../team/TeamMember.astro";
import teamMembers from "../../content/team/2026.json";

interface TeamMemberData {
  name: string;
  position: string;
  image: string;
}

const teamImageModules = import.meta.glob("../../assets/team/2026/*", {
  eager: true,
}) as Record<string, { default: ImageMetadata }>;

const teamImageByFileName = Object.fromEntries(
  Object.entries(teamImageModules).map(([path, imageMod]) => [
    path.split("/").pop() ?? "",
    imageMod.default,
  ]),
);

const resolvedTeamMembers = (teamMembers as TeamMemberData[]).map((member) => ({
  ...member,
  image:
    teamImageByFileName[member.image.split("/").pop() ?? ""] ?? member.image,
}));
---

<section id="team" class="w-full py-12 md:py-16">
  <div class="mx-auto w-full max-w-7xl px-4 md:px-8">
    <h2 class="mb-8 text-center text-3xl font-bold tracking-tight md:text-4xl">
      Our Team
    </h2>

    <div
      class="grid grid-cols-2 gap-5 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5"
    >
      {
        resolvedTeamMembers.map((member) => (
          <TeamMember
            imagePath={member.image}
            name={member.name}
            position={member.position}
          />
        ))
      }
    </div>
  </div>
</section>
