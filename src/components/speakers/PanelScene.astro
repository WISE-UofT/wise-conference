---
import { Image } from "astro:assets";
import mountains from "../../assets/illustrations/panel-mountains.png";
import rabbitSit from "../../assets/illustrations/rabbit-sit.png";
import rabbitLeap from "../../assets/illustrations/rabbit-leap.png";
---

<div
  class="pointer-events-none relative left-1/2 mt-2 h-28 w-screen -translate-x-1/2 opacity-45 md:h-32"
  aria-hidden="true"
>
  <Image
    src={mountains}
    alt=""
    class="absolute inset-x-0 bottom-0 w-full"
    width={1024}
    height={124}
  />
  <Image
    src={rabbitSit}
    alt=""
    class="absolute right-[20%] bottom-10 w-12 md:bottom-12 md:w-14"
    width={62}
    height={63}
  />
  <Image
    src={rabbitLeap}
    alt=""
    class="absolute right-[7%] bottom-3 w-[4.5rem] md:bottom-4 md:w-20"
    width={104}
    height={102}
  />
</div>
