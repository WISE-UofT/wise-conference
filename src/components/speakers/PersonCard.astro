---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  title?: string;
  image?: ImageMetadata;
  announced?: boolean;
  size?: "md" | "lg";
  bio?: string;
  pronouns?: string;
  preferredName?: string;
  objectPosition?: string;
  portrait?: boolean;
  dialogPrefix?: string;
  badge?: ImageMetadata;
  badgeClass?: string;
}

const {
  name,
  title,
  image,
  announced = true,
  size = "md",
  bio,
  pronouns,
  preferredName,
  objectPosition = "center 18%",
  portrait = false,
  dialogPrefix = "bio",
  badge,
  badgeClass = "w-20 -translate-y-[58%]",
} = Astro.props;

const dialogId = `${dialogPrefix}-${name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
const paragraphs = bio?.split(/\n+/).map((paragraph) => paragraph.trim()).filter(Boolean) ?? [];
const shapeClass = portrait ? "aspect-[6/7]" : "aspect-square";
const portraitClass = `${shapeClass} w-full object-cover object-[center_18%]`;
const placeholderClass = `${shapeClass} w-full bg-[#c9ccff]`;
---

<figure
  class:list={[
    "shrink-0 text-center",
    size === "lg" ? "w-48 sm:w-56" : "w-[9.25rem]",
  ]}
>
  {
    bio ? (
      <button
        type="button"
        class="block w-full cursor-pointer text-center"
        aria-haspopup="dialog"
        aria-controls={dialogId}
        onclick={`document.getElementById('${dialogId}')?.showModal()`}
      >
        <span class="relative block">
          {image ? (
            <Image
              src={image}
              alt=""
              width={640}
              class={portraitClass}
              style={{ objectPosition }}
            />
          ) : (
            <span class={portrait ? placeholderClass + " block" : "block aspect-square w-full bg-lilac"} />
          )}
          {badge && (
            <Image
              src={badge}
              alt=""
              width={160}
              class:list={["pointer-events-none absolute top-0 left-1/2 z-10 -translate-x-1/2", badgeClass]}
            />
          )}
        </span>
        <span class="mt-2.5 block">
          <span class="block text-sm font-bold leading-snug text-ink">{name}</span>
          {title && (
            <span class="mt-0.5 block text-xs leading-snug text-ink/75">{title}</span>
          )}
        </span>
      </button>
    ) : (
      <div class="relative">
        {image ? (
          <Image src={image} alt="" width={640} class={portraitClass} style={{ objectPosition }} />
        ) : (
          <div
            class={portrait ? placeholderClass : "aspect-square w-full bg-lilac"}
            role="img"
            aria-label={announced ? `${name}, photo coming soon` : "To be announced"}
          />
        )}
        {badge && (
          <Image
            src={badge}
            alt=""
            width={160}
            class:list={["pointer-events-none absolute top-0 left-1/2 z-10 -translate-x-1/2", badgeClass]}
          />
        )}
      </div>
    )
  }
  {
    !bio && (
      <figcaption class="mt-2.5">
        <p class="text-sm font-bold leading-snug text-ink">
          {announced ? name : "To be announced!"}
        </p>
        {announced && title && (
          <p class="mt-0.5 text-xs leading-snug text-ink/75">{title}</p>
        )}
      </figcaption>
    )
  }
</figure>

{
  bio && (
    <dialog
      id={dialogId}
      class="bio-dialog max-h-[min(85vh,100%)] w-[min(100%-2rem,46rem)] overflow-y-auto rounded-2xl border-0 bg-white p-6 text-ink shadow-2xl backdrop:bg-ink/45 md:p-8"
    >
      <div class="flex flex-col gap-6 md:flex-row">
        {image ? (
          <Image
            src={image}
            alt=""
            width={640}
            class="mx-auto h-52 w-52 shrink-0 object-cover object-[center_18%] md:mx-0"
            style={{ objectPosition }}
          />
        ) : (
          <div class="mx-auto h-52 w-52 shrink-0 bg-lilac md:mx-0" />
        )}
        <div class="min-w-0 text-left">
          <h3 class="font-serif text-2xl font-medium text-ink">{name}</h3>
          {preferredName && (
            <p class="mt-2 text-sm text-ink/80">
              Preferred name and pronunciation: {preferredName}
            </p>
          )}
          {pronouns && <p class="mt-1 text-sm text-ink/80">Pronouns: {pronouns}</p>}
          {title && <p class="mt-3 text-sm font-semibold text-ink">{title}</p>}
          <div class="mt-4 space-y-3 text-sm leading-6 text-ink/90">
            {paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
          <button
            type="button"
            class="mt-6 cursor-pointer rounded-full bg-ink px-5 py-2 text-sm font-semibold text-white"
            onclick="this.closest('dialog')?.close()"
          >
            Close
          </button>
        </div>
      </div>
    </dialog>
  )
}

<style>
  .bio-dialog {
    position: fixed;
    top: 50%;
    left: 50%;
    height: fit-content;
    margin: 0;
    transform: translate(-50%, -50%);
  }
</style>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (target instanceof HTMLDialogElement) target.close();
  });
</script>
