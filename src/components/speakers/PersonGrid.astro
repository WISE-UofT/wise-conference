---
interface Props {
  count: number;
  maxColumns?: 2 | 3;
  width?: "content" | "full";
  class?: string;
}

const {
  count,
  maxColumns = 2,
  width = "content",
  class: className = "",
} = Astro.props as Props;

const hasCenteredMobileRemainder = count > 1 && count % 2 === 1;
---

<div
  class:list={[
    "grid max-w-full items-start justify-items-center gap-x-5 gap-y-8 sm:gap-x-8",
    width === "full" ? "w-full" : "w-max",
    count === 1 ? "grid-cols-1" : "grid-cols-2",
    maxColumns === 3 && count >= 3 && count !== 4 && "md:grid-cols-3",
    hasCenteredMobileRemainder &&
      "[&>*:last-child]:col-span-2 [&>*:last-child]:justify-self-center",
    maxColumns === 3 && count === 3 &&
      "md:[&>*:last-child]:col-span-1",
    className,
  ]}
>
  <slot />
</div>
