---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  name: string;
  image: ImageMetadata | string;
  title: string;
  bio?: string;
  id?: string;
  pronouns?: string;
}

const {
  name,
  image,
  title,
  bio = "",
  id = "",
  pronouns,
} = Astro.props as Props;
---

<div
  class="flex h-full w-full cursor-pointer flex-col overflow-hidden rounded-2xl border border-blue-navy/10 bg-white shadow-sm transition-all hover:shadow-lg hover:border-blue-navy/30"
  onclick={bio
    ? `document.getElementById('bio-modal-${id}')?.classList.remove('hidden')`
    : undefined}
  role={bio ? "button" : undefined}
  tabindex={bio ? 0 : undefined}
>
  <Image
    src={image}
    alt={name}
    loading="lazy"
    class="aspect-[1/1] w-full object-cover"
  />

  <div class="flex-1 space-y-1 p-4">
    <h3 class="text-lg font-semibold text-blue-navy">{name}</h3>
    <p class="text-sm text-blue-navy/75">{title}</p>
  </div>
</div>
