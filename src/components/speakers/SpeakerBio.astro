---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  id: string;
  name: string;
  image?: ImageMetadata | string;
  title: string;
  bio: string;
  pronouns?: string;
}

const { id, name, image, title, bio, pronouns } = Astro.props as Props;
const initial = name.trim().charAt(0).toUpperCase();

// Split bio by newlines and render as paragraphs
const bioParagraphs = bio.split("\n").filter((p) => p.trim().length > 0);
---

<dialog
  id={`bio-modal-${id}`}
  class="bio-dialog max-h-[min(85vh,100%)] w-[min(100%-2rem,56rem)] overflow-y-auto rounded-2xl border-0 bg-white p-0 text-blue-navy shadow-lg backdrop:bg-black/50"
>
    <!-- Modal content -->
    <div
      class="flex flex-col items-center gap-6 p-6 text-center md:flex-row md:items-start md:p-8 md:text-left"
    >
      <!-- Image -->
      <div class="shrink-0 mx-auto md:mx-0">
        {
          image ? (
            typeof image === "string" ? (
              <img
                src={image}
                alt={name}
                class="h-48 w-48 flex rounded-xl object-cover shadow-md"
              />
            ) : (
              <Image
                src={image}
                alt={name}
                class="h-48 w-48 flex rounded-xl object-cover shadow-md"
              />
            )
          ) : (
            <div class="flex h-48 w-48 items-center justify-center rounded-xl bg-blue-navy/10 text-6xl font-semibold text-blue-navy/50 shadow-md">
              {initial}
            </div>
          )
        }
      </div>

      <!-- Text content -->
      <div class="min-w-0 flex-1">
        <div class="mb-2">
          <h2
            class="flex items-center gap-3 justify-center md:justify-start text-2xl font-bold text-blue-navy"
          >
            {name}
            {
              pronouns && (
                <span class="text-sm text-blue-navy/60 font-normal">
                  ({pronouns})
                </span>
              )
            }
          </h2>
        </div>
        <p
          class="mb-4 text-base text-center md:text-left font-medium text-blue-navy/75"
        >
          {title}
        </p>
        <div class="space-y-4 text-sm md:leading-7 text-blue-navy/85">
          {bioParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <button
          type="button"
          class="mt-6 cursor-pointer rounded-full bg-blue-navy px-5 py-2 text-sm font-semibold text-white"
          onclick="this.closest('dialog')?.close()"
        >
          Close
        </button>
      </div>
    </div>
</dialog>

<style>
  .bio-dialog {
    position: fixed;
    top: 50%;
    left: 50%;
    height: fit-content;
    margin: 0;
    transform: translate(-50%, -50%);
  }
</style>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (target instanceof HTMLDialogElement) target.close();
  });
</script>
