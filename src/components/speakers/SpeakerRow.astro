---
import type { DisplayPerson } from "../../lib/people";
import SpeakerCard from "./SpeakerCard.astro";
import SpeakerBio from "./SpeakerBio.astro";

interface Props {
  title: string;
  subtitle: string;
  description: string;
  speakers: DisplayPerson[];
  align?: "center" | "left";
  showHeader?: boolean;
  class?: string;
}

const {
  title,
  subtitle,
  description,
  speakers,
  align = "center",
  showHeader = true,
  class: className = "",
} = Astro.props as Props;
---

<div class={`mb-12 ${className}`.trim()}>
  {
    showHeader && (
      <>
        <h2
          class={`mb-3 text-2xl font-bold text-blue-navy ${
            align === "left" ? "text-left" : "text-center"
          }`.trim()}
        >
          {title}
        </h2>
        {subtitle && (
          <div
            class={`mb-6 text-xl italic leading-7 text-blue-navy/85 ${
              align === "left" ? "text-left" : "text-center"
            }`.trim()}
          >
            {subtitle}
          </div>
        )}
        {description && (
          <div
            class={`mb-8 text-base leading-7 text-blue-navy/85 ${
              align === "left"
                ? "max-w-none text-left"
                : "mx-auto max-w-4xl text-center"
            }`.trim()}
          >
            {description}
          </div>
        )}
      </>
    )
  }

  <div
    class={`flex flex-wrap items-stretch gap-5 ${
      align === "left" ? "justify-start" : "justify-center"
    }`.trim()}
  >
    {
      speakers.map((speaker) => (
        <div class="flex max-w-sm w-[calc((100%-1.25rem)/2)] sm:w-[calc((100%-1.25rem)/3)] lg:w-[calc((100%-6.25rem)/6)] lg:max-w-none">
          <SpeakerCard
            name={speaker.name}
            image={speaker.image}
            title={speaker.title ?? speaker.role}
            bio={speaker.bio}
            id={speaker.appearanceId}
          />
        </div>
      ))
    }
  </div>

  <!-- Bio Modals -->
  {
    speakers.map(
      (speaker) =>
        speaker.bio && (
          <SpeakerBio
            id={speaker.appearanceId}
            name={speaker.name}
            image={speaker.image}
            title={speaker.title ?? speaker.role}
            bio={speaker.bio}
            pronouns={speaker.pronouns}
          />
        ),
    )
  }
</div>
