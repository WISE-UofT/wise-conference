---
interface Props {
  title: string;
  id?: string;
  align?: "left" | "center";
}

const { title, id, align = "left" } = Astro.props;

const sectionId =
  id ??
  title
    .toLowerCase()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
---

<section
  id={sectionId}
  class="relative isolate mx-auto w-full max-w-6xl scroll-mt-32 px-5 py-14 md:px-8 md:py-16"
>
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <slot name="background" />
  </div>
  <h2
    class:list={[
      "relative z-10 font-serif text-[2rem] font-medium leading-tight tracking-tight text-ink md:text-[2.55rem]",
      align === "center" ? "text-center" : "text-left",
    ]}
  >
    {title}
  </h2>
  <div class="relative z-10 mt-6">
    <slot />
  </div>
</section>
